####################################################################################
# Variables to be need by services or customize servcies in the docker-compose.yml #
####################################################################################

# Project root path relative to this directory.
# Used to reference project-level configurations and assets (e.g., conf/, Dockerfile).
# Can be overridden via CENTIPEDE_ROOT when integrated into higher-level projects.
PROJECT_ROOT=${CENTIPEDE_ROOT:-../../}

# Note: the cm-honeybee service (deployments/docker-compose/docker-compose.yaml)
# builds from ../../../cm-honeybee/server — i.e. it expects the cm-honeybee
# repository cloned as a sibling of this repo (some-parent-dir/{cm-centipede, cm-honeybee}).
# There is no override variable for this path; move/symlink cm-honeybee to that
# location if you keep it elsewhere.

# Select which docker-compose files to run
COMPOSE_FILE=docker-compose.yaml
# Use the following line when Traefik is required for secure development and testing
# COMPOSE_FILE=docker-compose.yaml:docker-compose.traefik.yaml
# Use the following line to add CM-Damselfly + UI dashboard (port 3000):
# COMPOSE_FILE=docker-compose.yaml:docker-compose.ui.yaml

# ── CM-Centipede API Credentials ─────────────────────────────────────────────
# Placeholder for once CM-Centipede has its own container in docker-compose.yaml.
# CENTIPEDE_API_USERNAME=
# CENTIPEDE_API_PASSWORD=
#
# Passphrase the connection credentials in every stored migration plan are
# encrypted with. Required — cm-centipede refuses to start without it. Any
# passphrase of 12 or more characters; it is stretched into an AES-256 key with
# scrypt and a salt generated per database, so it need not be any particular
# length or encoding.
#
# Treat it as belonging to the data: it pairs with the cm-centipede db/ volume,
# and losing or changing either one makes every stored credential unrecoverable.
# CENTIPEDE_ENCRYPTION_SECRET_KEY=secret-key-change-me

# ── CM-Beetle API Credentials ────────────────────────────────────────────────
# CM-Beetle REST API username
BEETLE_API_USERNAME=
# CM-Beetle REST API password
BEETLE_API_PASSWORD=

# ── CB-Tumblebug API Credentials ─────────────────────────────────────────────
# CB-Tumblebug REST API username
TB_API_USERNAME=
# CB-Tumblebug REST API password
TB_API_PASSWORD=

# ── CB-Spider API Credentials ────────────────────────────────────────────────
# CB-Spider REST API username (used by both cb-spider and cb-tumblebug)
SP_API_USERNAME=
# CB-Spider REST API password
SP_API_PASSWORD=
# Note: if you change these from "default"/"default", also update
# deployments/docker-compose/cm-honeybee/cm-honeybee.yaml so CM-Honeybee's
# "csp" source-group type can still authenticate to CB-Spider.

# ── CB-Spider METADB (PostgreSQL) Credentials ────────────────────────────────
# Shared by cb-spider-postgres and cb-spider services
SP_POSTGRES_USER=
SP_POSTGRES_PASSWORD=
SP_POSTGRES_DB=

# ── MC-Terrarium API Credentials ─────────────────────────────────────────────
# MC-Terrarium REST API username
TERRARIUM_API_USERNAME=
# MC-Terrarium REST API password
TERRARIUM_API_PASSWORD=

# ── PostgreSQL Credentials ───────────────────────────────────────────────────
# Shared by cb-tumblebug-postgres and cb-tumblebug services
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# ── OpenBao (Secrets Management, shared by CB-Tumblebug / MC-Terrarium) ──────
# Persistent mode: auto-populated by ./openbao/openbao-init.sh after first init.
# Note: VAULT_TOKEN (not BAO_TOKEN) — required by OpenTofu hashicorp/vault provider.
VAULT_TOKEN=
# OpenBao API address (host-side; overridden inside Docker)
VAULT_ADDR=http://localhost:8200

# Note: cm-honeybee's own dedicated OpenBao (container "openbao-honeybee",
# host port 8201) is self-managed by cm-honeybee — no token/env var needed here.

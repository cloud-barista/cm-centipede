{
  "storageType": "filesystem",
  "path": "/home/YOUR_USERNAME/data",
  "filesystem": {
    "accessType": "ssh",
    "ssh": {
      "host": "YOUR_HOST",
      "port": 22,
      "username": "YOUR_USERNAME",
      "privateKeyPath": "/home/YOUR_LOCAL_USERNAME/.ssh/id_rsa"
    }
  },
  "filter": {
    "maxDepth": 0,
    "exclude": ["tmp", "temp", "logs"]
  }
}

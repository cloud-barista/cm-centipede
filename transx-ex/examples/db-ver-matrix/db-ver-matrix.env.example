# db-ver-matrix.env.example — shared configuration for the *-ver-matrix-migration.sh scripts
#
# Usage: copy this file, fill in the values, and the scripts pick it up.
#   cp db-ver-matrix.env.example db-ver-matrix.env
# db-ver-matrix.env is excluded from git (only this .example is committed).
#
# Precedence: CLI option > real shell variable > db-ver-matrix.env > script default
#
# What these scripts do: a per-version migration matrix. Every combination of the
#   source version list and the target version list runs as one cell. Each cell
#   starts fresh source/target containers from the official images, seeds a minimal
#   data set, migrates it with transx-ex, verifies the result and removes the
#   containers. No centipede or honeybee server is involved — transx-ex is called
#   directly as a library.

# ============================================================================
# Access mode
# ============================================================================
# MODE — direct : connect straight to the DB from the host with a pure Go driver
#                 (default, nothing to install)
#        ssh    : build a derived image with sshd on top of the official one and let
#                 transx-ex connect over SSH to run the dump tools inside the
#                 container (mysqldump/mariadb-dump/pg_dump/mongodump). The derived
#                 image is built once per version.
MODE=direct

# SRC_MODE / DST_MODE — set the source and target access modes separately.
#   Empty means "use MODE".
#   e.g. SRC_MODE=ssh, DST_MODE=direct -> read over SSH, write over a direct connection
#   With both on ssh the dump is piped without a file; every other combination
#   (mixed included) goes through a local staging file.
#   WARNING: MongoDB cannot mix the two — direct produces JSON and ssh produces an
#     archive, neither can read the other, and transx-ex rejects it in Validate.
SRC_MODE=
DST_MODE=

# ============================================================================
# Migration options
# ============================================================================
# The matrix always migrates a whole database, so there is no scope setting.

# SKIP_VERSION_CHECK — 0 lets transx-ex refuse a downgrade (higher -> lower version)
#   up front with VersionDowngradeError, which the matrix counts as BLOCK (expected).
#   1 skips the check and attempts the transfer, judging it PASS or FAIL.
SKIP_VERSION_CHECK=0

# ASYNC — 1 runs through MigrateDBMSAsync and polls progress.
ASYNC=0

# ROLLBACK_ON_FAILURE — 1 undoes objects created on the target when a migration fails.
ROLLBACK_ON_FAILURE=1

# ============================================================================
# Matrix version lists — source (rows) x target (columns)
#   The defaults cover every version the official images provide. A different list
#   works just as well, including a non-square matrix. CLI options override these:
#     ./mysql-ver-matrix-migration.sh --src-versions "8.0" --dst-versions "8.0 8.4"
# ============================================================================
MYSQL_SRC_VERSIONS="8.0 8.4"
MYSQL_DST_VERSIONS="8.0 8.4"

MARIADB_SRC_VERSIONS="10.6 10.11 11.4 11.8"
MARIADB_DST_VERSIONS="10.6 10.11 11.4 11.8"

POSTGRESQL_SRC_VERSIONS="13 14 15 16 17"
POSTGRESQL_DST_VERSIONS="13 14 15 16 17"

MONGODB_SRC_VERSIONS="6.0 7.0 8.0"
MONGODB_DST_VERSIONS="6.0 7.0 8.0"

# ============================================================================
# Container account and databases
# ============================================================================
# The scripts connect as the image's admin account (postgres for PostgreSQL, root
# for the others).
DB_ROOT_PASS=testpass123
# Name of the database being migrated. The same name is used on both sides.
SRC_DB=matrix_db
DST_DB=matrix_db

# ============================================================================
# Database character sets — applied when the source and target databases are created
# ============================================================================
# The scripts do not use the image init variables; they issue CREATE DATABASE with
# the values below. Tables inherit the database default, since they name no charset.
#
#   - An empty target value (*_DST_*) falls back to the source value, so the target
#     is built to match the source.
#   - An empty value omits the clause entirely and takes the server default.
#   - A collation the version does not know makes the cell FAIL at database creation
#     (it is never silently replaced with the server default).
#
# The default utf8mb4_general_ci exists in every MySQL 8.x and MariaDB 10.6-11.8
# release, so it works in any cell of the matrix. Version-specific examples:
#   MySQL 8.x        utf8mb4_0900_ai_ci
#   MariaDB 11.4+    utf8mb4_uca1400_ai_ci

MYSQL_SRC_CHARSET=utf8mb4
MYSQL_SRC_COLLATION=utf8mb4_general_ci
MYSQL_DST_CHARSET=
MYSQL_DST_COLLATION=

MARIADB_SRC_CHARSET=utf8mb4
MARIADB_SRC_COLLATION=utf8mb4_general_ci
MARIADB_DST_CHARSET=
MARIADB_DST_COLLATION=

# PostgreSQL uses an encoding and a locale. A locale other than the default requires
# creating the database from template0, which the script handles on its own.
# The official image ships only the C and en_US.utf8 locales.
POSTGRESQL_SRC_ENCODING=UTF8
POSTGRESQL_SRC_LOCALE=en_US.utf8
POSTGRESQL_DST_ENCODING=
POSTGRESQL_DST_LOCALE=

# MongoDB is UTF-8 only and has no character set. Only the default collation locale
# of a collection can be chosen; empty means none at all (binary ordering).
# e.g. ko, ja, en_US
MONGODB_SRC_COLLATION_LOCALE=
MONGODB_DST_COLLATION_LOCALE=

# ============================================================================
# Host ports — the 45xxx band. Change any of them when a port is already taken.
#   Containers are recreated for every cell, so two ports per engine is enough.
# ============================================================================
MYSQL_SRC_DB_PORT=45406
MYSQL_DST_DB_PORT=45407
MYSQL_SRC_SSH_PORT=45240
MYSQL_DST_SSH_PORT=45241

MARIADB_SRC_DB_PORT=45306
MARIADB_DST_DB_PORT=45307
MARIADB_SRC_SSH_PORT=45230
MARIADB_DST_SSH_PORT=45231

POSTGRESQL_SRC_DB_PORT=45432
POSTGRESQL_DST_DB_PORT=45433
POSTGRESQL_SRC_SSH_PORT=45250
POSTGRESQL_DST_SSH_PORT=45251

MONGODB_SRC_DB_PORT=45017
MONGODB_DST_DB_PORT=45018
MONGODB_SRC_SSH_PORT=45260
MONGODB_DST_SSH_PORT=45261

# MongoDB authentication database — where the admin account is created
MONGODB_AUTH_SOURCE=admin

# ============================================================================
# Run control
# ============================================================================
# ONLY_CELLS — run only these cells (space separated, "source:target"). Empty runs
#   the whole matrix.  e.g. ONLY_CELLS="8.0:8.4 8.4:8.4"
ONLY_CELLS=

# STOP_ON_FAIL — 1 stops the matrix at the first FAIL.
STOP_ON_FAIL=0

# KEEP_ON_FAIL — 1 keeps the containers of a failed cell for debugging.
KEEP_ON_FAIL=0

# READY_TIMEOUT — how long to wait for a container DB to accept queries, in seconds
READY_TIMEOUT=180

# NO_PAUSE — 1 runs straight through without waiting for a key between cells (default).
NO_PAUSE=1

# NO_LOG — 1 writes no log file.
NO_LOG=0

# ============================================================================
# Container address
# ============================================================================
# HOST_IP — address used to reach the published container ports.
#   Override it only when Docker is not reachable at 127.0.0.1 from this host.
HOST_IP=127.0.0.1

# .env.example — settings for setup_environment.sh and migrate.sh
#
# Usage: copy this file, fill in the values, and both scripts pick it up.
#   cp .env.example .env && chmod 600 .env
# .env is excluded from git (only this .example is committed).
#
# Precedence: real shell variable > .env
#
# Every value shipped as ChangeMe must be changed: the scripts stop before
# starting any container while one is still ChangeMe (compared
# case-insensitively). Neither password may be empty, and neither may contain
# " or \ - both are written into the generated config.json.

# root password of the source container (mysql_src)
SRC_PASS=ChangeMe
# root password of the target container (mysql_dst)
DST_PASS=ChangeMe

# Where the containers are reached. Change these only when they are not on this
# machine, e.g. SRC_HOST=192.168.1.10.
SRC_HOST=127.0.0.1
DST_HOST=127.0.0.1

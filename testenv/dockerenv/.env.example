# ──────────────────────────────────────────────────────────────────────────────
# cm-centipede dockerenv settings
#
#   cp .env.example .env && chmod 600 .env
#
#   Every value shipped as ChangeMe must be changed by you. dockerenv-up.sh stops
#   before building anything while one is still ChangeMe (compared
#   case-insensitively) or missing. .env is git-ignored; this file is not.
# ──────────────────────────────────────────────────────────────────────────────

# ──────────────────────────────────────────────────────────────────────────────
# Shared password for every account dockerenv creates - OS root and centipede
# (SSH), the DB admin (root / postgres), centipede and readonly accounts, and the
# MinIO root (minioadmin). Set when each container starts, never baked into an
# image.
#
# 8+ characters (MinIO's minimum), and none of  ' " \ $ `  or whitespace - it is
# written into SQL, JavaScript and shell inside the containers.
# ──────────────────────────────────────────────────────────────────────────────
DOCKERENV_PASSWORD=ChangeMe

# ──────────────────────────────────────────────────────────────────────────────
# DB versions (passed as build args from docker-compose.yml)
#
# Supported versions
#   MARIADB    : 10.6 (default) | 10.11 | 11.4 | 11.8
#   MYSQL      : 8.0 (default) | 8.4
#   POSTGRESQL : 13 | 14 (default) | 15 | 16 | 17
#   MONGODB    : 6.0 | 7.0 (default) | 8.0
# ──────────────────────────────────────────────────────────────────────────────
MARIADB_VERSION=10.6
MYSQL_VERSION=8.0
POSTGRESQL_VERSION=14
MONGODB_VERSION=7.0

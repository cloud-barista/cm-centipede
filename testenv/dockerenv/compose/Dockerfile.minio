FROM ubuntu:22.04

# ROLE=source -> 6 buckets with objects / ROLE=target -> 6 empty buckets
ARG ROLE=source

ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=Asia/Seoul

# ── Install base packages ─────────────────────────────────────────────────────
RUN apt-get update && apt-get install -y \
    systemd \
    systemd-sysv \
    dbus \
    openssh-server \
    curl \
    wget \
    openssl \
    rsync \
    sudo \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# ── Remove systemd units unnecessary in a container ───────────────────────────
RUN find /etc/systemd/system /lib/systemd/system \
    -path '*.wants/*' \( \
    -name '*getty*' -o \
    -name '*plymouth*' -o \
    -name '*apt-daily*' -o \
    -name 'systemd-timesyncd*' -o \
    -name '*udev*' \
    \) -exec rm -f {} \; 2>/dev/null || true

# ── Install the MinIO server + client ─────────────────────────────────────────
# dl.min.io no longer serves the community builds (410 Gone - the open-source
# project is archived), so both come from their GitHub releases instead. These
# are the last community releases that ship binaries; RELEASE.2025-10-15 is
# source-only. The checksum is pinned so a moved or replaced file fails the build.
ARG MINIO_RELEASE=RELEASE.2025-09-07T16-13-09Z
ARG MINIO_SHA256=7c5bd8512c6e966455b1d198209358b2d191c77a83ab377c4073281065fb855f
ARG MC_RELEASE=RELEASE.2025-08-13T08-35-41Z
ARG MC_SHA256=01f866e9c5f9b87c2b09116fa5d7c06695b106242d829a8bb32990c00312e891

RUN curl -fsSL -o /usr/local/bin/minio \
        "https://github.com/minio/minio/releases/download/${MINIO_RELEASE}/minio.linux-amd64.${MINIO_RELEASE}" \
    && echo "${MINIO_SHA256}  /usr/local/bin/minio" | sha256sum -c - \
    && chmod +x /usr/local/bin/minio
RUN curl -fsSL -o /usr/local/bin/mc \
        "https://github.com/minio/mc/releases/download/${MC_RELEASE}/mc.linux-amd64.${MC_RELEASE}" \
    && echo "${MC_SHA256}  /usr/local/bin/mc" | sha256sum -c - \
    && chmod +x /usr/local/bin/mc

# ── Copy resources + pick the role-specific init.sh ───────────────────────────
COPY scripts/  /opt/testenv/scripts/
COPY services/testenv-init.service /etc/systemd/system/testenv-init.service
COPY services/minio.service        /etc/systemd/system/minio.service

RUN chmod +x /opt/testenv/scripts/*.sh \
    && if [ "$ROLE" = "source" ]; then \
         cp /opt/testenv/scripts/02-setup-minio.sh /opt/testenv/init.sh; \
       else \
         cp /opt/testenv/scripts/target-minio.sh   /opt/testenv/init.sh; \
       fi \
    && chmod +x /opt/testenv/init.sh

# ── SSH setup: centipede user + password auth (passwords set at start, common.sh) ────────────────
RUN mkdir -p /var/run/sshd \
    && useradd -m -s /bin/bash centipede \
    && sed -i 's/^#*PasswordAuthentication.*/PasswordAuthentication yes/' /etc/ssh/sshd_config \
    && sed -i 's/^#*PermitRootLogin.*/PermitRootLogin yes/' /etc/ssh/sshd_config \
    && echo 'root ALL=(ALL) NOPASSWD:ALL' > /etc/sudoers.d/root-nopasswd \
    && chmod 0440 /etc/sudoers.d/root-nopasswd

# ── Enable systemd services ───────────────────────────────────────────────────
RUN systemctl enable minio.service testenv-init.service ssh.service

STOPSIGNAL SIGRTMIN+3
CMD ["/lib/systemd/systemd", "--system"]

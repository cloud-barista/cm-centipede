FROM ubuntu:22.04

# ROLE=source -> load shop_db/hr_db / ROLE=target -> create empty databases only
ARG ROLE=source
ARG DB_VERSION=8.0

ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=Asia/Seoul

# ── Install base packages ─────────────────────────────────────────────────────
RUN apt-get update && apt-get install -y \
    systemd \
    systemd-sysv \
    dbus \
    gnupg \
    lsb-release \
    openssh-server \
    curl \
    wget \
    openssl \
    rsync \
    sudo \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# ── Add the official MySQL repository + install (8.0, 8.4) ────────────────────
# The mysql-apt-config signing key has expired (EXPKEYSIG), which breaks apt update,
# so refresh the keyring directly with the latest key re-signed by repo.mysql.com.
RUN wget -q https://dev.mysql.com/get/mysql-apt-config_0.8.29-1_all.deb -O /tmp/mysql-apt-config.deb \
    && echo "mysql-apt-config mysql-apt-config/select-server select mysql-${DB_VERSION}" | debconf-set-selections \
    && DEBIAN_FRONTEND=noninteractive dpkg -i /tmp/mysql-apt-config.deb \
    && curl -fsSL https://repo.mysql.com/RPM-GPG-KEY-mysql-2025 \
        | gpg --batch --yes --dearmor -o /usr/share/keyrings/mysql-apt-config.gpg \
    && apt-get update && apt-get install -y mysql-server \
    && rm -f /tmp/mysql-apt-config.deb \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# ── Remove systemd units unnecessary in a container ───────────────────────────
RUN find /etc/systemd/system /lib/systemd/system \
    -path '*.wants/*' \( \
    -name '*getty*' -o \
    -name '*plymouth*' -o \
    -name '*apt-daily*' -o \
    -name 'systemd-timesyncd*' -o \
    -name '*udev*' \
    \) -exec rm -f {} \; 2>/dev/null || true

# ── MySQL config: remote access, event scheduler, utf8mb4 everywhere ──────────
# The sample data holds 4-byte UTF-8 (emoji); a utf8mb3 client connection would
# reject it with ERROR 1366, so pin both the server and the client to utf8mb4.
RUN printf '[mysqld]\nbind-address = 0.0.0.0\nevent_scheduler = ON\ncharacter-set-server = utf8mb4\ncollation-server = utf8mb4_unicode_ci\n\n[client]\ndefault-character-set = utf8mb4\n\n[mysql]\ndefault-character-set = utf8mb4\n' \
    > /etc/mysql/conf.d/99-testenv.cnf

# ── Copy resources + pick the role-specific init.sh ───────────────────────────
COPY sql/      /opt/testenv/sql/
COPY scripts/  /opt/testenv/scripts/
COPY services/testenv-init.service /etc/systemd/system/testenv-init.service

RUN chmod +x /opt/testenv/scripts/*.sh \
    && if [ "$ROLE" = "source" ]; then \
         cp /opt/testenv/scripts/01-setup-mysql.sh /opt/testenv/init.sh; \
       else \
         cp /opt/testenv/scripts/target-db-mysql.sh /opt/testenv/init.sh; \
       fi \
    && chmod +x /opt/testenv/init.sh

# ── SSH setup: create the centipede user + allow password auth ────────────────
RUN mkdir -p /var/run/sshd \
    && useradd -m -s /bin/bash centipede \
    && echo 'centipede:centipede_pass' | chpasswd \
    && sed -i 's/^#*PasswordAuthentication.*/PasswordAuthentication yes/' /etc/ssh/sshd_config \
    && sed -i 's/^#*PermitRootLogin.*/PermitRootLogin yes/' /etc/ssh/sshd_config \
    && echo 'root:testpass123' | chpasswd \
    && echo 'root ALL=(ALL) NOPASSWD:ALL' > /etc/sudoers.d/root-nopasswd \
    && chmod 0440 /etc/sudoers.d/root-nopasswd

# ── Enable systemd services ───────────────────────────────────────────────────
RUN systemctl enable mysql.service testenv-init.service ssh.service

STOPSIGNAL SIGRTMIN+3
CMD ["/lib/systemd/systemd", "--system"]

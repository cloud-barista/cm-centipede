FROM ubuntu:22.04

# ROLE=source -> load shop_db/hr_db / ROLE=target -> create empty databases only
ARG ROLE=source
ARG DB_VERSION=8.0

ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=Asia/Seoul

# ── Install base packages ─────────────────────────────────────────────────────
RUN apt-get update && apt-get install -y \
    systemd \
    systemd-sysv \
    dbus \
    gnupg \
    lsb-release \
    openssh-server \
    curl \
    wget \
    openssl \
    rsync \
    sudo \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# ── Add the official MySQL repository + install (8.0, 8.4) ────────────────────
# The source list is written here rather than by mysql-apt-config. That package
# (0.8.29) records the 8.4 component as "mysql-8.4", while repo.mysql.com names
# it "mysql-8.4-lts"; apt only warns about a missing component, and then installs
# Ubuntu's own mysql-server — 8.0 — for MYSQL_VERSION=8.4. The pin keeps Ubuntu's
# package out for the same reason, and the version check fails the build outright
# if the server is not the version asked for.
#
# The signing key is fetched directly: the one inside mysql-apt-config has
# expired (EXPKEYSIG).
RUN case "${DB_VERSION}" in \
        8.0) comp=mysql-8.0 ;; \
        8.4) comp=mysql-8.4-lts ;; \
        *)   echo "unsupported MySQL version: ${DB_VERSION}" >&2; exit 1 ;; \
    esac \
    && curl -fsSL https://repo.mysql.com/RPM-GPG-KEY-mysql-2025 \
        | gpg --batch --yes --dearmor -o /usr/share/keyrings/mysql.gpg \
    && echo "deb [signed-by=/usr/share/keyrings/mysql.gpg] http://repo.mysql.com/apt/ubuntu/ jammy ${comp}" \
        > /etc/apt/sources.list.d/mysql.list \
    && printf 'Package: *\nPin: origin repo.mysql.com\nPin-Priority: 1001\n' > /etc/apt/preferences.d/mysql \
    && apt-get update && apt-get install -y mysql-server \
    && mysqld --version | grep -q " ${DB_VERSION}\." \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# ── Remove systemd units unnecessary in a container ───────────────────────────
RUN find /etc/systemd/system /lib/systemd/system \
    -path '*.wants/*' \( \
    -name '*getty*' -o \
    -name '*plymouth*' -o \
    -name '*apt-daily*' -o \
    -name 'systemd-timesyncd*' -o \
    -name '*udev*' \
    \) -exec rm -f {} \; 2>/dev/null || true

# ── MySQL config: remote access, event scheduler, utf8mb4 everywhere ──────────
# The sample data holds 4-byte UTF-8 (emoji); a utf8mb3 client connection would
# reject it with ERROR 1366, so pin both the server and the client to utf8mb4.
#
# ⚠ Written into mysql.conf.d, not conf.d. my.cnf reads conf.d first and
#   mysql.conf.d second, so a bind-address = 127.0.0.1 in the package's
#   mysql.conf.d/mysqld.cnf would win and leave the server unreachable through the
#   published port. zz- sorts after mysqld.cnf, so this file is read last.
RUN printf '[mysqld]\nbind-address = 0.0.0.0\nmysqlx-bind-address = 0.0.0.0\nevent_scheduler = ON\ncharacter-set-server = utf8mb4\ncollation-server = utf8mb4_unicode_ci\n\n[client]\ndefault-character-set = utf8mb4\n\n[mysql]\ndefault-character-set = utf8mb4\n' \
    > /etc/mysql/mysql.conf.d/zz-testenv.cnf

# ── Copy resources + pick the role-specific init.sh ───────────────────────────
COPY sql/      /opt/testenv/sql/
COPY scripts/  /opt/testenv/scripts/
COPY services/testenv-init.service /etc/systemd/system/testenv-init.service

RUN chmod +x /opt/testenv/scripts/*.sh \
    && if [ "$ROLE" = "source" ]; then \
         cp /opt/testenv/scripts/01-setup-mysql.sh /opt/testenv/init.sh; \
       else \
         cp /opt/testenv/scripts/target-db-mysql.sh /opt/testenv/init.sh; \
       fi \
    && chmod +x /opt/testenv/init.sh

# ── SSH setup: centipede user + password auth (passwords set at start, common.sh) ────────────────
RUN mkdir -p /var/run/sshd \
    && useradd -m -s /bin/bash centipede \
    && sed -i 's/^#*PasswordAuthentication.*/PasswordAuthentication yes/' /etc/ssh/sshd_config \
    && sed -i 's/^#*PermitRootLogin.*/PermitRootLogin yes/' /etc/ssh/sshd_config \
    && echo 'root ALL=(ALL) NOPASSWD:ALL' > /etc/sudoers.d/root-nopasswd \
    && chmod 0440 /etc/sudoers.d/root-nopasswd

# ── Enable systemd services ───────────────────────────────────────────────────
RUN systemctl enable mysql.service testenv-init.service ssh.service

STOPSIGNAL SIGRTMIN+3
CMD ["/lib/systemd/systemd", "--system"]

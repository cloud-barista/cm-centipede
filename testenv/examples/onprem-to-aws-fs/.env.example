# onprem-to-aws-fs — settings for migrate.sh
#
#   cp .env.example .env && chmod 600 .env
#
#   Every value shipped as ChangeMe must be changed: migrate.sh stops before its
#   first call while one is still ChangeMe (compared case-insensitively).
#   A variable set in the shell wins over this file:
#     NODE_ID=vm-other-01-1 ./migrate.sh

# ── Servers ──────────────────────────────────────────────────────────────────
HB_BASE=http://localhost:8081/honeybee
CP_BASE=http://localhost:8085/centipede
# cm-centipede's BasicAuth (centipede.api.username / password in its config)
CP_USER=ChangeMe
CP_PASS=ChangeMe

# ── Source — the on-premises machine (testenv/dockerenv fs-source) ───────────
# The address of the host the source container runs on, reached through the
# port it publishes - not the container's address, and not 127.0.0.1.
HOST_IP=ChangeMe
SRC_PORT=32210
SRC_USER=root
SRC_KEY=../../dockerenv/ssh_keys/id_rsa
SRC_PATH=/testdata

# ── Target — the AWS VM (testenv/beetleenv) ──────────────────────────────────
# All three ids come from: testenv/beetleenv/scripts/conn-info.sh aws --ids
NS_ID=cpbt01
INFRA_ID=cpbt-aws-infra
NODE_ID=vm-beetleenv-source-01-1
DST_PATH=/home/cb-user/testdata

NAME=onprem-to-aws-fs
POLL=5

# onprem-to-aws-mysql — settings for migrate.sh
#
#   cp .env.example .env && chmod 600 .env
#
#   Every value shipped as ChangeMe must be changed: migrate.sh stops before its
#   first call while one is still ChangeMe (compared case-insensitively).
#   A variable set in the shell wins over this file:
#     SRC_DB=hr_db DST_DB=hr_db ./migrate.sh
#
#   PASSWORDS IN PLAIN TEXT. SRC_DB_PASS and DB_PASSWORD written here sit on disk
#   in plain text, protected only by this file's mode (600). If that is a concern,
#   leave them empty here and pass them in when you run the script:
#     SRC_DB_PASS=... DB_PASSWORD=... ./migrate.sh
#   Empty here and not passed in, the script stops before its first call.

# ── Servers ──────────────────────────────────────────────────────────────────
HB_BASE=http://localhost:8081/honeybee
CP_BASE=http://localhost:8085/centipede
# cm-centipede's BasicAuth (centipede.api.username / password in its config)
CP_USER=ChangeMe
CP_PASS=ChangeMe

# ── Source — the on-premises MySQL (testenv/dockerenv mysql-source) ──────────
# The address of the host the source container runs on, reached through the
# port it publishes - not the container's address, and not 127.0.0.1.
HOST_IP=ChangeMe
SRC_PORT=33406
SRC_DB_USER=centipede
# DOCKERENV_PASSWORD in testenv/dockerenv/.env. See PASSWORDS above.
SRC_DB_PASS=ChangeMe
SRC_DB=shop_db

# ── Target — the AWS RDS instance (testenv/beetleenv) ────────────────────────
# NS_ID and RDBMS_ID come from: testenv/beetleenv/scripts/conn-info.sh aws --ids
NS_ID=cpbt01
RDBMS_ID=cpbt-aws-db-mysql
# The instance's master password. cm-beetle never hands it back, so cm-centipede
# has to be told: BEETLEENV_AWS_DB_PASSWORD in testenv/beetleenv/.env.
# See PASSWORDS above.
DB_PASSWORD=ChangeMe
DST_DB=shop_db

NAME=onprem-to-aws-mysql
POLL=5

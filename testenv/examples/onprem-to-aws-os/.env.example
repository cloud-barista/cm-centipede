# onprem-to-aws-os — settings for migrate.sh
#
#   cp .env.example .env && chmod 600 .env
#
#   Every value shipped as ChangeMe must be changed: migrate.sh stops before its
#   first call while one is still ChangeMe (compared case-insensitively).
#   A variable set in the shell wins over this file:
#     SRC_BUCKET=documents ./migrate.sh
#
#   KEY IN PLAIN TEXT. SRC_SECRET_KEY written here sits on disk in plain text,
#   protected only by this file's mode (600). If that is a concern, leave it
#   empty here and pass it in when you run the script:
#     SRC_SECRET_KEY=... ./migrate.sh
#   Empty here and not passed in, the script stops before its first call.

# ── Servers ──────────────────────────────────────────────────────────────────
HB_BASE=http://localhost:8081/honeybee
CP_BASE=http://localhost:8085/centipede
# cm-centipede's BasicAuth (centipede.api.username / password in its config)
CP_USER=ChangeMe
CP_PASS=ChangeMe

# ── Source — the on-premises MinIO (testenv/dockerenv minio-source) ──────────
# The address of the host the source container runs on, reached through the
# port it publishes - not the container's address, and not 127.0.0.1.
HOST_IP=ChangeMe
SRC_PORT=39000
SRC_ACCESS_KEY=minioadmin
# DOCKERENV_PASSWORD in testenv/dockerenv/.env. See KEY above.
SRC_SECRET_KEY=ChangeMe
SRC_BUCKET=images

# ── Target — the AWS bucket (testenv/beetleenv) ──────────────────────────────
# Both ids come from: testenv/beetleenv/scripts/conn-info.sh aws --ids
NS_ID=cpbt01
OS_ID=cpbt-aws-bucket

NAME=onprem-to-aws-os
POLL=5

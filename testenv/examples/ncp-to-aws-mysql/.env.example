# ncp-to-aws-mysql — settings for migrate.sh
#
#   cp .env.example .env && chmod 600 .env
#
#   Every value shipped as ChangeMe must be changed: migrate.sh stops before its
#   first call while one is still ChangeMe (compared case-insensitively).
#   A variable set in the shell wins over this file:
#     SRC_DB=otherdb ./migrate.sh
#
#   PASSWORDS IN PLAIN TEXT. SRC_DB_PASS and DB_PASSWORD written here sit on disk
#   in plain text, protected only by this file's mode (600). If that is a concern,
#   leave them empty here and pass them in when you run the script:
#     SRC_DB_PASS=... DB_PASSWORD=... ./migrate.sh
#   Empty here and not passed in, the script stops before its first call.

# ── Servers ──────────────────────────────────────────────────────────────────
HB_BASE=http://localhost:8081/honeybee
CP_BASE=http://localhost:8085/centipede
# cm-centipede's BasicAuth (centipede.api.username / password in its config)
CP_USER=ChangeMe
CP_PASS=ChangeMe

# ── Source — the NCP managed MySQL (testenv/tofuenv) ─────────────────────────
# There is no region to resolve here: a db connection carries its own host and
# port, so SRC_PROVIDER records where the data lives and nothing is derived
# from it.
SRC_PROVIDER=ncp
# The DB server's PUBLIC DOMAIN. It cannot be known in advance: it is issued once
# per server from the NCP console, and only then does tofu report it:
#   testenv/tofuenv/scripts/conn-info.sh ncp database
SRC_HOST=ChangeMe
SRC_PORT=3306
SRC_DB_USER=dbadmin
# The NCP DB master password. tofuenv keeps it in OpenBao (secret/db/ncp) and
# blanks NCP_DB_PASSWORD out of its own .env. See PASSWORDS above.
SRC_DB_PASS=ChangeMe
SRC_DB=testdb

# ── Target — the AWS RDS instance (testenv/beetleenv) ────────────────────────
# NS_ID and RDBMS_ID come from: testenv/beetleenv/scripts/conn-info.sh aws --ids
NS_ID=cpbt01
RDBMS_ID=cpbt-aws-db-mysql
# The instance's master password. cm-beetle takes it when the instance is created
# and never hands it back, so cm-centipede has to be told: the same value as
# BEETLEENV_AWS_DB_PASSWORD in testenv/beetleenv/.env. See PASSWORDS above.
DB_PASSWORD=ChangeMe
DST_DB=testdb

NAME=ncp-to-aws-mysql
POLL=5

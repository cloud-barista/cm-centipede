# ncp-to-aws-os — settings for migrate.sh
#
#   cp .env.example .env && chmod 600 .env
#
#   Every value shipped as ChangeMe must be changed: migrate.sh stops before its
#   first call while one is still ChangeMe (compared case-insensitively).
#   A variable set in the shell wins over this file:
#     SRC_BUCKET=my-bucket ./migrate.sh
#
#   KEYS IN PLAIN TEXT. SRC_ACCESS_KEY and SRC_SECRET_KEY written here sit on disk
#   in plain text, protected only by this file's mode (600). If that is a concern,
#   leave them empty here and pass them in when you run the script:
#     SRC_ACCESS_KEY=... SRC_SECRET_KEY=... ./migrate.sh
#   Empty here and not passed in, the script stops before its first call.

# ── Servers ──────────────────────────────────────────────────────────────────
HB_BASE=http://localhost:8081/honeybee
CP_BASE=http://localhost:8085/centipede
# cm-centipede's BasicAuth (centipede.api.username / password in its config)
CP_USER=ChangeMe
CP_PASS=ChangeMe

# ── Source — the NCP bucket (testenv/tofuenv) ────────────────────────────────
# There is no address to supply: NCP Object Storage is somewhere both cm-honeybee
# and cm-centipede already know how to find. What they cannot work out is which
# NCP, so the region is named - region_name on the source group, and the region
# in the host "<region>.object.ncloudstorage.com". Lowercase: tofuenv writes
# TF_VAR_ncp_region as "KR" and the host is "kr.…".
SRC_PROVIDER=ncp
SRC_REGION=kr
# TF_VAR_ncp_bucket_name in testenv/tofuenv/.env
SRC_BUCKET=ChangeMe
# The NCP access key pair. tofuenv keeps it in OpenBao (secret/csp/ncp) and
# blanks it out of its own .env. See KEYS above.
SRC_ACCESS_KEY=ChangeMe
SRC_SECRET_KEY=ChangeMe

# ── Target — the AWS bucket (testenv/beetleenv) ──────────────────────────────
# Both ids come from: testenv/beetleenv/scripts/conn-info.sh aws --ids
NS_ID=cpbt01
OS_ID=cpbt-aws-bucket

NAME=ncp-to-aws-os
POLL=5

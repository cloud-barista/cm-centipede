# Credentials and secrets
.env
*.tfvars
!*.tfvars.example

# OpenBao unseal key + root token
init/openbao/secrets/*.json

# Container runtime data (OpenBao storage and other decrypted secrets)
container-volume/

# SSH private keys for VM access, generated by tofu
ssh_keys/*.pem
*.pem

# OpenTofu state - contains plaintext secrets, so it must never be committed
*.tfstate
*.tfstate.*
.terraform/
.terraform.lock.hcl
.tofu-plugin-cache/
crash.log

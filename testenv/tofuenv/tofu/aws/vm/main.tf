# The key file carries the prefix: each prefix is an environment of its own (a tofu
# workspace), and a fixed name would let the next one overwrite this VM's key.
locals {
  key_name           = "${var.aws_name_prefix}-vm"
  key_file_name      = "aws-${var.aws_name_prefix}-vm.pem"
  container_key_path = "${var.ssh_key_dir}/${local.key_file_name}"
  host_key_path      = "ssh_keys/${local.key_file_name}" # Relative to the host-side tofuenv directory.

  is_windows = var.aws_vm_os == "windows"
  ssh_user   = local.is_windows ? "Administrator" : "ubuntu"
  # C:/testdata rather than the Administrator profile: a folder made there before
  # the first logon makes Windows create the profile as Administrator.<host>.
  data_path = var.aws_data_path != "" ? var.aws_data_path : (local.is_windows ? "C:/testdata" : "/home/ubuntu/testdata")

  # --- servers installed on the VM ---
  servers = var.aws_vm_servers
  # From OpenBao: register-creds.sh stores TF_VAR_aws_vm_server_password there and
  # blanks it in .env. A value still in .env (--keep-env, or set since and not yet
  # registered) wins, so what .env says is what gets applied.
  server_password = var.aws_vm_server_password != "" ? var.aws_vm_server_password : try(
    data.vault_kv_secret_v2.vm[0].data["TF_VAR_aws_vm_server_password"], ""
  )
  # Each server's ports, opened to allowed_cidr. mariadb moves to 3307 so it can
  # run next to mysql.
  server_ports = {
    minio      = [{ port = 9000, desc = "MinIO API" }, { port = 9001, desc = "MinIO console" }]
    mysql      = [{ port = 3306, desc = "MySQL" }]
    mariadb    = [{ port = 3307, desc = "MariaDB" }]
    postgresql = [{ port = 5432, desc = "PostgreSQL" }]
    mongodb    = [{ port = 27017, desc = "MongoDB" }]
  }
  ingress_ports = concat(
    local.is_windows ? [{ port = 3389, desc = "RDP" }] : [],
    flatten([for s in local.servers : local.server_ports[s]]),
  )
  # The CLI tools each server must leave on PATH; checked after the install.
  server_tools = {
    minio      = ["minio"]
    mysql      = ["mysql", "mysqldump"]
    mariadb    = ["mariadb", "mariadb-dump"]
    postgresql = ["psql", "pg_dump"]
    mongodb    = ["mongosh", "mongodump"]
  }
  tools = flatten([for s in local.servers : local.server_tools[s]])

  # MinIO's community builds are only on GitHub now (dl.min.io answers 410), and
  # the project is archived, so the default release is pinned by checksum. Any
  # other release is checked against the .sha256sum file published next to it.
  minio_sha256 = {
    "RELEASE.2025-09-07T16-13-09Z" = {
      linux   = "7c5bd8512c6e966455b1d198209358b2d191c77a83ab377c4073281065fb855f"
      windows = "af709e6ba68488404e85acdd22a3030d0f5e56a108d4b27d744f18ceb50861b4"
    }
  }

  servers_script = length(local.servers) == 0 ? "" : (local.is_windows
    ? templatefile("${path.module}/templates/servers-windows.ps1.tpl", {
      servers          = join(",", local.servers)
      username         = var.aws_vm_server_username
      password         = local.server_password
      db_name          = var.aws_vm_db_name
      minio_bucket     = var.aws_vm_minio_bucket
      mysql_version    = var.aws_vm_mysql_version
      mariadb_version  = var.aws_vm_mariadb_version
      postgres_version = var.aws_vm_postgres_version
      mongodb_version  = var.aws_vm_mongodb_version
      minio_release    = var.aws_vm_minio_release
      minio_sha256     = try(local.minio_sha256[var.aws_vm_minio_release].windows, "")
      tools            = join(",", local.tools)
      firewall_ports   = join(",", [for p in local.ingress_ports : p.port])
    })
    : templatefile("${path.module}/templates/servers-ubuntu.sh.tpl", {
      servers         = join(" ", local.servers)
      username        = var.aws_vm_server_username
      password        = local.server_password
      db_name         = var.aws_vm_db_name
      minio_bucket    = var.aws_vm_minio_bucket
      mysql_version   = var.aws_vm_mysql_version
      mariadb_version = var.aws_vm_mariadb_version
      postgres_major  = split(".", var.aws_vm_postgres_version)[0]
      mongodb_series  = join(".", slice(split(".", var.aws_vm_mongodb_version), 0, 2))
      minio_release   = var.aws_vm_minio_release
      minio_sha256    = try(local.minio_sha256[var.aws_vm_minio_release].linux, "")
      tools           = join(" ", local.tools)
  }))
}

# --- SSH key pair (generated by tofu) ---
resource "tls_private_key" "vm" {
  algorithm = "RSA"
  rsa_bits  = 4096
}

resource "aws_key_pair" "vm" {
  key_name   = local.key_name
  public_key = tls_private_key.vm.public_key_openssh
}

resource "local_sensitive_file" "vm_key" {
  content         = tls_private_key.vm.private_key_pem
  filename        = local.container_key_path
  file_permission = "0600"
}

# --- Ubuntu 22.04 AMI ---
data "aws_ami" "ubuntu" {
  most_recent = true
  owners      = ["099720109477"] # Canonical

  filter {
    name   = "name"
    values = ["ubuntu/images/hvm-ssd/ubuntu-jammy-22.04-amd64-server-*"]
  }
  filter {
    name   = "virtualization-type"
    values = ["hvm"]
  }
}

# --- Windows Server 2022 AMI, only when aws_vm_os = windows ---
data "aws_ami" "windows" {
  count = local.is_windows ? 1 : 0

  most_recent = true
  owners      = ["amazon"]

  filter {
    name   = "name"
    values = ["Windows_Server-2022-English-Full-Base-*"]
  }
  filter {
    name   = "virtualization-type"
    values = ["hvm"]
  }
}

data "aws_vpc" "default" {
  default = true
}

# --- Security group (SSH) ---
resource "aws_security_group" "vm" {
  name        = "${var.aws_name_prefix}-vm-sg"
  description = "cm-centipede migration test VM"
  vpc_id      = data.aws_vpc.default.id

  ingress {
    description = "SSH"
    from_port   = 22
    to_port     = 22
    protocol    = "tcp"
    cidr_blocks = [var.allowed_cidr]
  }

  # RDP on windows, and the ports of the servers installed on the VM. Inline, like
  # SSH above, so adding a server updates this group in place.
  dynamic "ingress" {
    for_each = local.ingress_ports
    content {
      description = ingress.value.desc
      from_port   = ingress.value.port
      to_port     = ingress.value.port
      protocol    = "tcp"
      cidr_blocks = [var.allowed_cidr]
    }
  }

  egress {
    from_port   = 0
    to_port     = 0
    protocol    = "-1"
    cidr_blocks = ["0.0.0.0/0"]
  }

  tags = {
    Project   = "cm-centipede"
    ManagedBy = "opentofu"
  }
}

# --- NFS (EFS), only when aws_nfs_enabled ---
# A mount target goes into every default subnet, one per AZ, so the VM mounts it
# wherever it lands. EFS is reachable from inside the VPC only.
data "aws_subnets" "default" {
  filter {
    name   = "vpc-id"
    values = [data.aws_vpc.default.id]
  }
  filter {
    name   = "default-for-az"
    values = ["true"]
  }
}

resource "aws_efs_file_system" "nfs" {
  count = var.aws_nfs_enabled ? 1 : 0

  creation_token = "${var.aws_name_prefix}-nfs"
  encrypted      = true

  tags = {
    Name      = "${var.aws_name_prefix}-nfs"
    Project   = "cm-centipede"
    ManagedBy = "opentofu"
    Purpose   = "migration-test"
  }
}

resource "aws_security_group" "nfs" {
  count = var.aws_nfs_enabled ? 1 : 0

  name        = "${var.aws_name_prefix}-nfs-sg"
  description = "cm-centipede migration test NFS (EFS)"
  vpc_id      = data.aws_vpc.default.id

  ingress {
    description     = "NFS from the VM"
    from_port       = 2049
    to_port         = 2049
    protocol        = "tcp"
    security_groups = [aws_security_group.vm.id]
  }

  tags = {
    Project   = "cm-centipede"
    ManagedBy = "opentofu"
  }
}

resource "aws_efs_mount_target" "nfs" {
  for_each = var.aws_nfs_enabled ? toset(data.aws_subnets.default.ids) : toset([])

  file_system_id  = aws_efs_file_system.nfs[0].id
  subnet_id       = each.value
  security_groups = [aws_security_group.nfs[0].id]
}

# --- EC2 instance used as the filesystem migration test target ---
resource "aws_instance" "vm" {
  ami                         = local.is_windows ? data.aws_ami.windows[0].id : data.aws_ami.ubuntu.id
  instance_type               = var.aws_instance_type
  key_name                    = aws_key_pair.vm.key_name
  vpc_security_group_ids      = [aws_security_group.vm.id]
  associate_public_ip_address = true

  # ubuntu: mounts the EFS file system on first boot. null without NFS, so a VM
  # prepared before this option existed sees no change. cloud-init runs
  # user_data only once, so a changed script has to come with a new instance to
  # take effect at all.
  # windows: installs and starts OpenSSH Server with the generated key, which is
  # what the server install below and gendata's SFTP connect through.
  user_data = local.is_windows ? templatefile("${path.module}/templates/windows-init.ps1.tpl", {
    public_key = trimspace(tls_private_key.vm.public_key_openssh)
    data_path  = replace(local.data_path, "/", "\\")
    }) : (var.aws_nfs_enabled ? templatefile("${path.module}/templates/vm-init.sh.tpl", {
      nfs_dns_name = aws_efs_file_system.nfs[0].dns_name
      mount_path   = var.aws_nfs_mount_path
      ssh_user     = local.ssh_user
  }) : null)
  user_data_replace_on_change = true

  # The Administrator password, encrypted with the key pair; outputs.tf decrypts it
  # for RDP. Waits for EC2 to publish it, which takes a few minutes after launch.
  get_password_data = local.is_windows

  # The mount targets have to exist before the VM boots and tries to mount.
  depends_on = [aws_efs_mount_target.nfs]

  root_block_device {
    volume_size = var.aws_vm_volume_size
  }

  lifecycle {
    precondition {
      condition     = !(local.is_windows && var.aws_nfs_enabled)
      error_message = "aws_nfs_enabled is not supported with aws_vm_os = windows: EFS does not support Windows clients."
    }
    precondition {
      condition     = !local.is_windows || var.aws_vm_volume_size >= 30
      error_message = "aws_vm_os = windows needs aws_vm_volume_size of at least 30 GB (the Windows Server AMI's own size)."
    }
    precondition {
      condition     = length(local.servers) == 0 || nonsensitive(local.server_password != "")
      error_message = "aws_vm_servers is not empty, but no server password was found: set TF_VAR_aws_vm_server_password in .env and register it (./scripts/register-creds.sh)."
    }
  }

  tags = {
    Name      = "${var.aws_name_prefix}-vm"
    Project   = "cm-centipede"
    ManagedBy = "opentofu"
    Purpose   = "migration-test"
  }
}

# --- Servers installed on the VM, only when aws_vm_servers is not empty ---
# Installed over SSH rather than from user_data: the script is far over user_data's
# 16 KB, and this way the apply waits for the install and fails when it fails. A
# failed run leaves this resource tainted; prepare.sh aws vm --force runs it again.
#
# A separate resource rather than a part of the instance, so adding a server or
# changing a version re-runs the install on the same VM instead of replacing it.
# The scripts are idempotent: what is installed is kept, accounts are reset.
# Removing a server closes its ports and nulls its outputs, but leaves it installed.
resource "terraform_data" "servers" {
  count = length(local.servers) > 0 ? 1 : 0

  # The script carries the password, so only its hash is kept here.
  triggers_replace = [aws_instance.vm.id, nonsensitive(sha256(local.servers_script))]

  connection {
    type            = "ssh"
    host            = aws_instance.vm.public_ip
    user            = local.ssh_user
    private_key     = tls_private_key.vm.private_key_pem
    target_platform = local.is_windows ? "windows" : "unix"
    # windows: sshd only answers once user_data has installed OpenSSH.
    timeout = local.is_windows ? "30m" : "10m"
  }

  # C:\cptf is created by windows-init before sshd starts. The script deletes
  # itself when it ends, since it holds the password.
  provisioner "file" {
    content     = local.servers_script
    destination = local.is_windows ? "C:/cptf/servers.ps1" : "/tmp/cptf-servers.sh"
  }

  provisioner "remote-exec" {
    inline = local.is_windows ? [
      "powershell -NoProfile -NonInteractive -ExecutionPolicy Bypass -File C:/cptf/servers.ps1",
      ] : [
      # cloud-init may still be holding apt (or mounting NFS); 2 means it finished
      # with recoverable errors, which is not this script's concern.
      "sudo cloud-init status --wait >/dev/null 2>&1 || true",
      "sudo bash /tmp/cptf-servers.sh",
    ]
  }

  # A fresh SSH session, so it sees PATH as a new login would. The install script
  # has already checked the tools against the registry/symlinks and failed if one
  # is missing; on windows this only warns, since whether sshd hands a new session
  # the updated machine PATH is up to sshd.
  provisioner "remote-exec" {
    inline = local.is_windows ? [
      "where ${join(" ", local.tools)} || echo WARNING: a new SSH session does not see every tool on PATH yet - restart sshd or log in again",
      ] : [
      "for t in ${join(" ", local.tools)}; do command -v $t >/dev/null || { echo \"missing on PATH: $t\"; exit 1; }; done; echo \"on PATH: ${join(" ", local.tools)}\"",
    ]
  }
}

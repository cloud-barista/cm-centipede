# ==============================================================================
# Environment variable template for the tofuenv provisioning environment
# ------------------------------------------------------------------------------
#   1) Copy this file to .env:  cp .env.example .env && chmod 600 .env
#      Mode 600 is enforced: up.sh and register-creds.sh refuse to read a .env
#      anyone else can. VAULT_TOKEN below is the OpenBao root token and is never
#      blanked, so this file stays sensitive long after the CSP keys are gone.
#   2) Fill in [SHARED] and the section for the CSP you use. You can leave the
#      other CSP section untouched - unused values are simply ignored.
#   3) Run ./scripts/up.sh to start OpenBao, init, unseal and register credentials.
#
#   This file is organised by CSP:
#
#     [SHARED]  OpenBao + inbound network access     always required
#     [AWS]     credentials + settings               skip if you do not use AWS
#     [NCP]     credentials + settings               skip if you do not use NCP
#
#   Keys marked [CREDENTIAL] are sensitive. On successful registration,
#   register-creds.sh stores them in OpenBao and then blanks them here, so no
#   plaintext key stays on disk. Everything else is kept as is.
#
#   .env is listed in .gitignore. Never commit it.
# ==============================================================================


# ==============================================================================
# ===
# ===   S H A R E D        required regardless of which CSP you use
# ===
# ==============================================================================

# --- OpenBao ------------------------------------------------------------------
#   VAULT_TOKEN is filled in automatically when openbao-init.sh runs; leave it
#   empty on a fresh setup.
#   VAULT_ADDR is the address used to reach OpenBao FROM THE HOST. Inside
#   containers, docker-compose injects http://openbao:8200 instead.
VAULT_ADDR=http://localhost:38200
VAULT_TOKEN=

# --- Inbound network access ---------------------------------------------------
#   Applies to both AWS security groups and NCP ACGs. Wide open by default for
#   convenience; narrow it to your own address (e.g. 1.2.3.4/32) for real use.
TF_VAR_allowed_cidr=0.0.0.0/0

# --- gendata test data size ---------------------------------------------------
#   How much test data ./scripts/gen-data.sh generates. The same numbers apply to
#   both CSPs, which is why they sit here rather than in a CSP section.
#
#   These are NOT TF_VAR_*: OpenTofu never reads them. gendata does - .env is
#   sourced with `set -a`, so gendata inherits them - and they override the
#   defaults in gendata/config/config.json. A flag on the command line wins over
#   both. A key gendata does not recognise is reported when gen-data.sh runs.
#
#   Mind the provisioned capacity: the dummy files also have to fit on the VM's
#   volume (TF_VAR_aws_vm_volume_size, 20 GB) and the database size on the
#   instance's storage (AWS 20 GB, NCP a fixed 10 GB). gendata refuses a request
#   over 80% of either, since an instance that fills its disk has to be
#   deprovisioned and provisioned again rather than just cleaned up. A data path
#   on the VM's EFS mount is not checked - EFS grows with what is written.

#   Dummy files for the bucket and filesystem targets: the TOTAL in MB, over all
#   eight formats (csv, txt, sql, json, xml, png, gif, zip). It is split 1 MB at a
#   time in that order, so 8 is 1 MB of each and 10 gives csv and txt 2 MB.
#   Leave it unset to use config.json, where every format is 1 MB.
GENDATA_DUMMY_SIZE_MB=8

#   Per-format sizes in MB. The formats named here keep their size, and what is
#   left of GENDATA_DUMMY_SIZE_MB is split over the others; 0 switches a format
#   off. With GENDATA_DUMMY_SIZE_MB=1000 the line below makes zip 100 MB, drops
#   png and gif, and splits the other 900 MB over the five text formats (180 MB
#   each). Naming more than the total is an error.
#GENDATA_DUMMY_SIZES=png=0,gif=0,zip=100

#   The most dummy files to generate; 0 means no limit. Leave it unset to use
#   config.json (layout.maxFiles, 1000). Over the limit the total size is kept
#   and the files grow instead; png and gif stay at 20 MB a file at most, and
#   formats beyond the limit are skipped - see gendata/README.md, "layout".
#GENDATA_DUMMY_MAX_FILES=1000

#   Bulk rows added to each database AFTER the shop_db fixture, in MB.
#   0 - the default - loads the fixture only. The fixture is what carries the
#   tables, views, procedures, triggers and the multibyte rows a migration is
#   judged on; this is volume on top of it, spread over customers, products,
#   orders, order_items, reviews and inventory_log.
#   Expect the loaded size to differ from what is asked for: it is an estimate of
#   rows, and each engine adds its own overhead. gendata reports what actually
#   landed, and runs/last-run.json records it.
GENDATA_DB_SIZE_MB=0


# ##############################################################################
# ###
# ###   A W S        S3 bucket / RDS (mysql, mariadb, postgres) / EC2 (vm)
# ###
# ##############################################################################

# --- [CREDENTIAL] Access key --------------------------------------------------
#   Stored in OpenBao secret/csp/aws, then blanked here.
#   The IAM user needs S3, RDS and EC2 permissions, plus EFS for the VM's NFS.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- [CREDENTIAL] DB master password ------------------------------------------
#   Stored in OpenBao secret/db/aws, then blanked here.
AWS_DB_PASSWORD=

# --- Region, sizing and naming ------------------------------------------------
#   name_prefix is short for "centipede tofu" - it names every AWS resource this
#   environment creates (cptf-vm, cptf-mysql, cptf-rds-sg, ...) so they are easy
#   to tell apart from anything else in the account. 2-20 lowercase characters.
#   The bucket is not covered by it, since an S3 name must be globally unique.
#
#   The prefix is also the environment: every module keeps one state per prefix
#   and every script acts on this one only. Changing it starts a NEW environment
#   next to the old one, which keeps running and costing money until you put its
#   prefix back and deprovision it. ./scripts/list.sh shows every environment.
#   Each environment needs its own TF_VAR_aws_bucket_name. "default" is reserved.
TF_VAR_aws_region=ap-northeast-2
TF_VAR_aws_name_prefix=cptf
TF_VAR_aws_instance_type=t3.micro
TF_VAR_aws_vm_volume_size=20                 # VM root volume in GB
TF_VAR_aws_db_instance_class=db.t3.micro
TF_VAR_aws_db_allocated_storage=20           # RDS storage in GB, each of the three engines

# --- Bucket -------------------------------------------------------------------
#   An S3 bucket name is globally unique across ALL AWS accounts, so common
#   names are already taken and the apply fails with BucketAlreadyExists.
#   Append a date or your own identifier. Lowercase, digits and hyphens, 3-63 chars.
TF_VAR_aws_bucket_name=cptf-aws-bucket-test

# --- Database name and master account -----------------------------------------
#   PostgreSQL reserves names such as admin and rdsadmin, so they cannot be used
#   as the master account. dbadmin is safe on all three engines.
TF_VAR_aws_db_name=testdb
TF_VAR_aws_db_username=dbadmin

# --- DB engine versions -------------------------------------------------------
#   The versions RDS supports change over time; check with
#     aws rds describe-db-engine-versions --engine <engine> --region <region>
TF_VAR_aws_mysql_version=8.0       # Supported by RDS: 5.7, 8.0, 8.4
TF_VAR_aws_mariadb_version=10.6    # Supported by RDS: 10.5, 10.6, 10.11, 11.4, 11.8  (11.8+ sets require_secure_transport=ON, i.e. TLS required)
TF_VAR_aws_postgres_version=14     # Supported by RDS: 11, 12, 13, 14, 15, 16, 17, 18

# --- Plaintext client connections ---------------------------------------------
#   RDS enforces TLS by default on some engine versions, and a client that
#   insists on plaintext then cannot connect:
#     mysql      never enforced by default
#     mariadb    require_secure_transport=ON from 11.8
#     postgres   rds.force_ssl=1 from 15
#   With the versions above (8.0 / 10.6 / 14) none of the three enforce it.
#
#   csp-default  leave the RDS default alone (default)
#   off          attach a parameter group allowing plaintext
#
#   ⚠ Fixed at creation time. To change it on an already provisioned module:
#       ./scripts/deprovision.sh aws database
#       ./scripts/provision.sh   aws database
#     Re-applying with --force would attach the group to running instances and
#     leave postgres waiting for a reboot it never gets.
TF_VAR_aws_secure_transport=csp-default

# --- Filesystem test data path ------------------------------------------------
#   Where gendata writes the filesystem migration data on the VM. It must be
#   writable by the login account: SFTP cannot sudo. AWS images log in as ubuntu.
#TF_VAR_aws_data_path=/home/ubuntu/testdata

# --- NFS (EFS) mounted on the VM ----------------------------------------------
#   true creates an EFS file system alongside the VM and mounts it over NFS at
#   TF_VAR_aws_nfs_mount_path. The IAM user then also needs EFS permissions
#   (elasticfilesystem:*).
#
#   The mount path and TF_VAR_aws_data_path above are independent settings that
#   share a default, so with both left alone the test data lands ON the NFS
#   mount. Point one of them elsewhere and the data stays on the local disk
#   while the NFS is mounted on its own.
#
#   The mount path must not be /, /home, /home/ubuntu (it would hide
#   .ssh/authorized_keys and lock SSH out) or a system directory.
#
#   ⚠ Fixed at creation time. Changing either value on a provisioned VM needs
#     ./scripts/provision.sh aws vm --force, which RE-CREATES the VM - data on
#     its local disk is lost. EFS and its data go with ./scripts/deprovision.sh aws vm.
TF_VAR_aws_nfs_enabled=false
#TF_VAR_aws_nfs_mount_path=/home/ubuntu/testdata


# ##############################################################################
# ###
# ###   N C P        Object Storage / managed Cloud DB / server (vm)
# ###
# ##############################################################################

# --- [CREDENTIAL] Access key --------------------------------------------------
#   Stored in OpenBao secret/csp/ncp, then blanked here.
#   Issue them at: Portal > My Page > Manage Authentication Key.
#   Object Storage (S3-compatible API) uses this same key pair.
NCP_ACCESS_KEY=
NCP_SECRET_KEY=

# --- [CREDENTIAL] DB master password ------------------------------------------
#   Stored in OpenBao secret/db/ncp, then blanked here.
#   The provider enforces these rules and a violation fails the apply, so
#   register-creds.sh rejects a bad password up front:
#     - 8 to 20 characters
#     - at least one letter, one digit and one special character
#     - allowed special characters: ~ ! @ # $ % ^ * ( ) - _ = [ ] { } ; : , . < > ?
#     - forbidden:  ` & + \ " ' /  and whitespace
#   Example: Cent1pede!2024
NCP_DB_PASSWORD=

# --- Region, zone and naming --------------------------------------------------
#   name_prefix is short for "centipede tofu" - it tags every NCP resource this
#   environment creates so they are easy to tell apart from anything else in the
#   account. It stays short because the managed MongoDB service_name is limited
#   to 15 characters (cptf-mongodb is 12).
#
#   The prefix is also the environment, exactly as TF_VAR_aws_name_prefix above:
#   changing it starts a new one (its own VPC included) next to the old one.
#   ./scripts/list.sh shows every environment. Each needs its own bucket name.
TF_VAR_ncp_region=KR
TF_VAR_ncp_zone=KR-2
TF_VAR_ncp_name_prefix=cptf
TF_VAR_ncp_vpc_cidr=10.10.0.0/16

# --- Bucket -------------------------------------------------------------------
#   Unique within the region. Lowercase, digits, dots and hyphens, 3-63 chars.
TF_VAR_ncp_bucket_name=cptf-ncp-bucket-test

# --- Server image and spec (used by the VM) -----------------------------------
#   Verify they exist with: ./scripts/ncp-db-versions.sh server
TF_VAR_ncp_server_image_name=ubuntu-22.04-base
TF_VAR_ncp_server_spec_code=s2-g3

# --- Database name and master account -----------------------------------------
TF_VAR_ncp_db_name=testdb
TF_VAR_ncp_db_username=dbadmin

# --- DB engine versions -------------------------------------------------------
#   Always use the FULL version string. With a partial version such as 8.0, the
#   provider normalizes state to 8.0.36 and every plan then schedules a DB
#   re-creation that takes about 30 minutes.
#   List the supported versions with: ./scripts/ncp-db-versions.sh
TF_VAR_ncp_mysql_version=8.0.36       # 8.0.36, 8.0.40, 8.0.42, 8.0.45, 8.4.6, 8.4.8
TF_VAR_ncp_postgres_version=14.22     # 13.3, 13.21, 14.13, 14.18, 14.20, 14.22, 15.15, 15.17
TF_VAR_ncp_mongodb_version=7.0.28     # 6.0.27, 7.0.19, 7.0.24, 7.0.28, 8.0.19

# --- Filesystem test data path ------------------------------------------------
#   Where gendata writes the filesystem migration data on the server. It must be
#   writable by the login account: SFTP cannot sudo. NCP images log in as root.
#TF_VAR_ncp_data_path=/root/testdata

# =============================================================================
# Environment for the filesystem migration matrix (beetle-fs-test)
#
#   cp .env.example .env && chmod 600 .env
#
#   Precedence:  CLI option > real shell variable > .env > script default
#
#   WHAT THIS ENVIRONMENT DOES
#     The source is a container this folder builds - Ubuntu 22.04 with systemd,
#     sshd and a seeded /testdata. cm-honeybee logs into it, installs its agent
#     and inspects the tree; cm-centipede migrates the whole tree to a node that
#     cm-beetle creates on each CSP, then validates it by comparing SHA256 per
#     file on both machines.
#
#   NO CSP KEYS LIVE HERE. cb-tumblebug holds them, registered once by the
#   deployments stack (make init). This file names regions and zones, not
#   credentials.
#
#   THE ONE SECRET THIS FOLDER HANDLES IS NOT IN THIS FILE EITHER. The SSH key
#   pair that opens the source container is generated per run into the run's
#   temporary directory and dies with it.
#
#   NOT SHARED WITH beetleenv, beetle-db-test, beetle-os-test, tofuenv OR
#   dockerenv. Namespace, name prefix, container name and published port are all
#   this folder's own, so any of them can be up at the same time.
#
#   Every resource is named <prefix>-<csp>-<what>:
#     cpbfs-aws-infra, cpbfs-aws-vnet, cpbfs-aws-subnet-1, cpbfs-aws-subnet-2,
#     cpbfs-aws-sg, cpbfs-aws-sshkey
#   The CSP is in the name because one namespace holds every CSP's resources and
#   a cb-tumblebug id is unique per namespace, not per connection. --cleanup
#   matches on that prefix, which is why there is no local state file.
# =============================================================================

# -----------------------------------------------------------------------------
# Identity
# -----------------------------------------------------------------------------
#   2-6 characters. Every resource name and the --cleanup match are built from it.
MATRIX_NAME_PREFIX=cpbfs

#   The cb-tumblebug namespace every migration call needs. This folder's own -
#   sharing one with another environment makes --cleanup everyone's problem.
MATRIX_NS=cpbfs01

# -----------------------------------------------------------------------------
# The provisioner - cm-beetle and cb-tumblebug
# -----------------------------------------------------------------------------
#   Both must already be running, together with cb-spider. This environment
#   starts nothing at all.
#
#   Every call about a resource goes to cm-beetle. cb-tumblebug is addressed
#   directly in exactly two places - the namespace (beetle has no namespace API)
#   and the connection catalogue (it is tumblebug's own).
#
#   BEETLE_URL must include the /beetle path prefix.
BEETLE_URL=http://localhost:8056/beetle
BEETLE_USERNAME=default
BEETLE_PASSWORD=default

TUMBLEBUG_URL=http://localhost:1323/tumblebug
TUMBLEBUG_USERNAME=default
TUMBLEBUG_PASSWORD=default

#   cm-beetle throttles its cb-tumblebug calls and answers 503 with Retry-After
#   when there is no room. That is "in a moment", not a failure, so it is retried.
MATRIX_RATE_LIMIT_RETRIES=3

# -----------------------------------------------------------------------------
# The migration stack - cm-honeybee and cm-centipede
# -----------------------------------------------------------------------------
#   Both servers must already be running. This environment starts neither.
#   Step 1 of every run checks them before a single resource is created.
HB_BASE=http://localhost:8081/honeybee
CP_BASE=http://localhost:8085/centipede
CP_USER=default
CP_PASS=default

#   One SourceGroup holds the source connection this matrix registers. It is
#   created if absent and reused afterwards. It MUST be type "fs": honeybee
#   refuses a filesystem inspect on any other type, in as many words. A group
#   found under this name carrying another type stops the run at step 4.
HB_SOURCE_GROUP=cpbfs-matrix

#   Registering the connection is also what installs cm-honeybee's agent on the
#   source - honeybee downloads the binary and then polls for it - so the call
#   takes tens of seconds rather than milliseconds. Seconds.
HB_TIMEOUT=600

#   Migration.Name carries a unique index, so each cell gets
#   <MIGRATION_PREFIX>-<csp>-<timestamp>.
MIGRATION_PREFIX=cpbfs

#   KEEP_MIGRATION=1 leaves the migration records in centipede's database so a
#   finished run can still be read back through its API. 0 deletes each as its
#   cell ends.
KEEP_MIGRATION=1

#   Polling and patience, in seconds.
POLL_INTERVAL=5
MIGRATION_TIMEOUT=1800
VALIDATION_TIMEOUT=600

#   GET /migration/{id}/logs is paginated (default 20, max 100 per page). The
#   matrix walks to the end rather than reading one page.
CP_LOG_PAGE_SIZE=100
CP_LOG_MAX_PAGES=50

# -----------------------------------------------------------------------------
# The one axis - which CSPs to run
# -----------------------------------------------------------------------------
#   One cell per CSP: the whole dataset migrated to one node there.
#
#   There is no second axis. The object storage matrix has one because a bucket
#   is made in seconds and costs nothing empty; a node takes minutes and bills,
#   so a per-directory row would mean a VM per directory to learn the same thing.
#
#   Every name here needs a registered <csp>-<region> connection. There is no
#   support endpoint to check against - any CSP cb-tumblebug can build a VM on
#   works, which is all of them.
FS_CSPS="aws ncp"

# -----------------------------------------------------------------------------
# Per-CSP placement
# -----------------------------------------------------------------------------
#   REGION must match the region the connection was registered under: the
#   connection name is built as <csp>-<region>, lower case.
#
#   ZONE and ZONE2 are both required. The vNet gets two subnets in two zones
#   because that is the shape cb-tumblebug expects; the node always takes the
#   first, which is why ZONE - and only ZONE - has to be the zone the connection
#   is assigned to. When they disagree, cb-spider recommends a spec from one zone
#   and the CSP is asked for it in another, and the error names neither. The run
#   checks this before anything is created (assert_vm_zone) and tells you which
#   way round to put them.
#
#   VNET_CIDR must be a /16 unless you also set SUBNET1_CIDR and SUBNET2_CIDR:
#   the two /24s are derived from it by replacing the third octet.

AWS_REGION=ap-northeast-2
AWS_ZONE=ap-northeast-2a
AWS_ZONE2=ap-northeast-2c
AWS_VNET_CIDR=10.41.0.0/16
#AWS_SUBNET1_CIDR=10.41.1.0/24
#AWS_SUBNET2_CIDR=10.41.2.0/24

#   NCP's region ids are upper case in cloudinfo.yaml, and the connection name is
#   built from this value, so it has to match what was registered.
NCP_REGION=KR
NCP_ZONE=KR-1
NCP_ZONE2=KR-2
NCP_VNET_CIDR=10.42.0.0/16
#NCP_SUBNET1_CIDR=10.42.1.0/24
#NCP_SUBNET2_CIDR=10.42.2.0/24

# -----------------------------------------------------------------------------
# The target node
# -----------------------------------------------------------------------------
#   What cm-beetle is told the source machine looks like. It answers with a spec
#   and an image that fit. Nothing here reaches a CSP directly - it is a
#   description, and beetle's recommendation turns it into a real specification.
#
#   Per CSP, so a CSP whose catalogue has nothing small can be given its own
#   numbers. Unset falls back to 2 vCPU / 4 GB / 20 GB / ubuntu 22.04 / x86_64.
#
#   ⚠ rsync has to be on the image. transx-ex shells out to `rsync -e ssh` and
#     needs it on both ends. Ubuntu's cloud images ship it; a minimal image may
#     not, and the run's node probe says so before the transfer rather than
#     during it.
#AWS_NODE_VCPU=2
#AWS_NODE_MEMORY_GB=4
#AWS_NODE_DISK_GB=20
AWS_NODE_OS="ubuntu 22.04"
#AWS_NODE_ARCH=x86_64

#NCP_NODE_VCPU=2
#NCP_NODE_MEMORY_GB=4
#NCP_NODE_DISK_GB=20
NCP_NODE_OS="ubuntu 22.04"
#NCP_NODE_ARCH=x86_64

#   The security group opens 22 inbound, and only 22: cm-centipede rsyncs over
#   SSH and checksums over SSH, and the node is a destination rather than a
#   service.
#
#   ⚠ 0.0.0.0/0 because the address cm-centipede leaves from is the docker host's
#     egress address, NAT'd, and not something this folder can work out. Narrow it
#     when you know it. Local testing only, either way.
FS_ALLOWED_CIDR=0.0.0.0/0

# -----------------------------------------------------------------------------
# The source container
# -----------------------------------------------------------------------------
#   One container serves the whole run: the dataset is inspected once and every
#   CSP migrates that same inspection.
#
#   ⚠ It needs OUTBOUND INTERNET. cm-honeybee installs its agent by running a
#     script on the source that downloads the binary from
#     raw.githubusercontent.com and media.githubusercontent.com. That URL is
#     hard-coded in cm-honeybee and nothing here can redirect it.

#   The dataset root. Also what honeybee is asked to inspect, and the srcName the
#   plan's mapping matches against.
FS_SRC_PATH=/testdata

#   Published SSH port. The 34xxx band is this folder's own: beetle-os-test uses
#   33xxx and dockerenv its own range, so both can be up at once.
FS_SRC_SSH_PORT=34922

#   How cm-honeybee and cm-centipede reach that published port.
HOST_IP=127.0.0.1

#   Scan depth for honeybee's inspect. 0 is unlimited. It changes what the
#   collection result LISTS, not what migrates - the plan is built against the
#   scan root, so the whole tree moves either way.
FS_SCAN_MAX_DEPTH=0

#   The first image build installs Ubuntu packages, so give it room. Seconds.
SRC_BUILD_TIMEOUT=900
READY_TIMEOUT=300

#   FS_REBUILD_SOURCE=1 rebuilds the image even when one is cached. Needed after
#   editing anything under src/.
FS_REBUILD_SOURCE=0

# -----------------------------------------------------------------------------
# Patience with the node
# -----------------------------------------------------------------------------
#   A node is built in minutes, not seconds - this is the main way a filesystem
#   cell differs from an object storage one in wall clock. Seconds.
NODE_TIMEOUT=1800
NODE_POLL_INTERVAL=10

#   Waiting for beetle to report SSH as ready.
#   ⚠ beetle rate limits that endpoint to one check per infrastructure every 30
#     seconds and answers 429 in between, so the poll interval is fixed at 35 in
#     the script and is not a setting.
SSH_READY_TIMEOUT=900

#   sshd can accept connections a moment after beetle says the node is ready, and
#   cloud-init may still be writing authorized_keys. Attempts, 10s apart.
NODE_PROBE_RETRIES=6

#   cb-tumblebug answers "deletion unconfirmed" while the CSP is still releasing
#   a resource. Retries, and seconds between them.
DELETE_RETRIES=3
DELETE_RETRY_WAIT=30

# -----------------------------------------------------------------------------
# Run behaviour
# -----------------------------------------------------------------------------
#   All of these have a CLI equivalent, which wins.

#   Subset. Empty means "everything in FS_CSPS".
#ONLY_CSPS=

#   ⚠ KEEP_NODE=1 and KEEP_ON_FAIL=1 leave a RUNNING VM behind. It bills until it
#     is removed, and only ./scripts/fs-matrix.sh --cleanup or the CSP console
#     will do that.
KEEP_NODE=0
KEEP_ON_FAIL=0

#   KEEP_NETWORK=1 leaves the vNet, security group and SSH key. They cost nothing
#   and the next run adopts them, which makes a repeated single-CSP run quicker.
KEEP_NETWORK=0

#   KEEP_SOURCE=1 leaves the source container running. The run's key pair is
#   still deleted with the run's temporary directory, so the container stays up
#   but nothing can log into it afterwards.
KEEP_SOURCE=0

#   KEEP_NAMESPACE=1 keeps the cb-tumblebug namespace on --cleanup. It is free to
#   keep and the next run reuses it.
KEEP_NAMESPACE=0

#   Stop at the first FAIL instead of running the remaining CSPs.
STOP_ON_FAIL=0

#   NO_PAUSE=0 waits for a keypress after each cell. Useful for watching one cell
#   at a time; requires a tty.
NO_PAUSE=1

#   NO_LOG=1 writes neither .log file. The result JSON is still written.
NO_LOG=0

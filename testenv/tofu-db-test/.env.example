# ==============================================================================
# Environment for the managed-DB version matrix (tofu-db-test)
# ------------------------------------------------------------------------------
#   1) cp .env.example .env && chmod 600 .env
#      Mode 600 is enforced, not advised: up.sh and register-creds.sh refuse to
#      read a .env anyone else can. VAULT_TOKEN below is the OpenBao root token
#      and is never blanked, so this file stays sensitive long after the CSP
#      keys are gone.
#   2) Fill in [SHARED], [MIGRATION STACK] and the section for the CSP you use.
#   3) ./scripts/up.sh            starts OpenBao, registers credentials, blanks them
#   4) ./scripts/aws-db-matrix.sh
#
#   Precedence:  CLI option > real shell variable > .env > script default
#
#   Keys marked [CREDENTIAL] are moved into OpenBao and blanked here on a
#   successful ./scripts/up.sh. Everything else is kept as is.
#
#   WHAT THIS ENVIRONMENT DOES
#     The source is a container this folder builds - Ubuntu 22.04 with systemd,
#     playing the on-premises role. The target is a managed instance created with
#     OpenTofu. Every (source version x target version) pair runs as one cell:
#     cm-honeybee collects the source, cm-centipede plans, migrates and
#     validates. One target version = one managed instance = real money.
#
#   NOT SHARED WITH tofuenv OR dockerenv. Container names, network, published
#   ports and resource prefix all differ, so all three can be up at once, and
#   nothing here is read from those folders.
# ==============================================================================


# ==============================================================================
# ===   S H A R E D
# ==============================================================================

# --- OpenBao ------------------------------------------------------------------
#   VAULT_ADDR reaches OpenBao FROM THE HOST; inside containers docker-compose
#   injects http://openbao:8200 instead. 38210 is chosen so tofuenv (38200) can
#   stay up alongside. Leave VAULT_TOKEN empty - ./scripts/up.sh fills it in.
VAULT_ADDR=http://localhost:38210
VAULT_TOKEN=

# --- The tofu runner ----------------------------------------------------------
#   Must match container_name in docker-compose.yaml. Every tofu command runs
#   inside it via docker exec; tofu is never installed on the host.
TOFU_RUNNER=cptfm-tofu-runner

# --- Naming and inbound access ------------------------------------------------
#   Every resource is named <prefix>-...  (cptfm-mysql-8-0 on AWS, cptfm-my8036
#   on NCP, cptfm-vpc, cptfm-subnet). Keep it distinct from tofuenv's cptf.
#   2-6 lowercase characters: the NCP managed MongoDB service_name is capped at
#   15, so a long prefix leaves no room for the version.
MATRIX_NAME_PREFIX=cptfm

#   Inbound CIDR opened on the engine port. The host running the matrix and the
#   host running cm-centipede must both be inside it.
MATRIX_ALLOWED_CIDR=0.0.0.0/0

# --- Admin database -----------------------------------------------------------
#   Created together with the managed instance. The matrix connects here to
#   create and drop each cell's target database - you cannot DROP the database
#   you are connected to.
ADMIN_DB=matrixadm


# ==============================================================================
# ===   M I G R A T I O N   S T A C K        cm-honeybee + cm-centipede
# ==============================================================================
#   Both servers must already be running. This environment starts neither.
#   Step 1 of every run checks them before a single instance is created.

HB_BASE=http://localhost:8081/honeybee

#   cm-centipede requires BasicAuth on every call.
CP_BASE=http://localhost:8085/centipede
CP_USER=default
CP_PASS=default

# --- honeybee bookkeeping -----------------------------------------------------
#   One SourceGroup holds every source connection this matrix registers; the
#   per-engine ConnectionInfo is named <group>-<engine>-src and reused across
#   cells, since the address and port of a source container do not change with
#   its version. Collection is re-run for every cell, because the database
#   behind that endpoint has been replaced.
HB_SOURCE_GROUP=cptfm-matrix

# --- centipede bookkeeping ----------------------------------------------------
#   Migration.Name carries a unique index, so each cell gets
#   <prefix>-<engine>-<src>-<dst>-<timestamp>.
MIGRATION_PREFIX=cptfm

#   KEEP_MIGRATION=1 leaves the migration records in centipede's database so a
#   cell can be re-read afterwards (GET /migration/<id>/logs). 0 deletes each
#   record once its verdict has been written to the result JSON.
KEEP_MIGRATION=1

#   DBMS_ON_FAILURE - what centipede does with a target database whose item
#   failed. cleanup (default) undoes it; keep leaves the partial result in place
#   for inspection. The matrix drops the target database itself at the end of
#   every cell either way, so keep only matters while you are looking.
DBMS_ON_FAILURE=cleanup

# --- Polling ------------------------------------------------------------------
#   centipede is asynchronous: POST /migration returns immediately and the run
#   is followed by polling. MIGRATION_TIMEOUT has to cover the slowest cell, not
#   the average one.
POLL_INTERVAL=5
MIGRATION_TIMEOUT=1800
VALIDATION_TIMEOUT=600

# --- The migration log ---------------------------------------------------------
#   Every cell prints GET /migration/{id}/logs after validation. That endpoint is
#   paginated - 20 entries by default, 100 at most - so the matrix walks to the
#   end of the pages rather than reading one and quietly showing a prefix.
#
#   CP_LOG_PAGE_SIZE is the handler's maximum; lower it only to see the paging
#   work. CP_LOG_MAX_PAGES is a stop, so a wrong total cannot spin forever - at
#   the default that is 5000 entries, and a cell reaching it says how many were
#   left out rather than looking finished.
CP_LOG_PAGE_SIZE=100
CP_LOG_MAX_PAGES=50


# ==============================================================================
# ===   S O U R C E        containers this folder builds (the row axis)
# ==============================================================================
#   src/Dockerfile.<engine> builds Ubuntu 22.04 + systemd + the vendor apt
#   repository, so `systemctl` works, sshd is a unit and the database is a
#   service that starts at boot. src/scripts/init-<engine>.sh then creates the
#   account, the database and the seed, and matrix-init.service reaching
#   "active" is the single readiness signal the matrix waits on.
#
#   ⚠ These containers run --privileged with /sys/fs/cgroup mounted rw, which is
#     what systemd needs. Local testing only, never production.

# --- Address ------------------------------------------------------------------
#   HOST_IP is how a published container port is reached - by the matrix for its
#   readiness check, and by cm-honeybee for the source connection it registers.
#   One value serves both, but it has to satisfy the stricter of the two:
#
#     honeybee on this host       127.0.0.1 works
#     honeybee in a container     127.0.0.1 points at honeybee itself and finds
#                                 nothing; use the host's LAN address
#                                 (e.g. 172.24.78.163), which the matrix's own
#                                 check reaches just as well
HOST_IP=127.0.0.1

# --- Accounts and databases ---------------------------------------------------
#   SRC_DB_USER is the account cm-honeybee connects with; it holds every
#   privilege on the source, because a migration reads routines and triggers as
#   well as rows. DB_ROOT_PASS is the engine's own superuser, used inside the
#   container during initialization.
#
#   DST_DB is created empty inside the managed instance for every cell.
#   centipede does NOT create it: it creates a target database only for
#   providerName=onprem, and a managed target is aws or ncp.
SRC_DB_USER=centipede
SRC_DB_PASS=centipede_pass
DB_ROOT_PASS=testpass123
SRC_DB=matrix_db
DST_DB=matrix_db

# --- Source character set -----------------------------------------------------
#   Used verbatim in the source CREATE DATABASE, inside the container. There is
#   no target counterpart: the target database follows the managed instance's
#   defaults, and centipede reports a difference as a warning rather than a
#   failure. Table character sets travel inside the dump's CREATE TABLE
#   statements. Leave a value empty to take the server default.
MYSQL_SRC_CHARSET=utf8mb4
MYSQL_SRC_COLLATION=utf8mb4_general_ci
MARIADB_SRC_CHARSET=utf8mb4
MARIADB_SRC_COLLATION=utf8mb4_general_ci
POSTGRESQL_SRC_ENCODING=UTF8
POSTGRESQL_SRC_LOCALE=
MONGODB_SRC_COLLATION_LOCALE=

# --- Published host ports -----------------------------------------------------
#   The 36xxx band, clear of dockerenv (32xxx/33xxx/35xxx/37xxx/39xxx), the
#   docker matrix (34xxx) and the transx-ex example (45xxx). dockerenv may well
#   be up at the same time, so these must not collide with it.
MYSQL_SRC_DB_PORT=36406
MYSQL_SRC_SSH_PORT=36240
MARIADB_SRC_DB_PORT=36306
MARIADB_SRC_SSH_PORT=36230
POSTGRESQL_SRC_DB_PORT=36432
POSTGRESQL_SRC_SSH_PORT=36252
MONGODB_SRC_DB_PORT=36017
MONGODB_SRC_SSH_PORT=36270

# --- Source access mode -------------------------------------------------------
#   direct  honeybee connects to the published port
#   ssh     honeybee is registered with db_access_type=ssh-tunnel, so the dump
#           tools run inside the container. sshd is already a unit in the image,
#           so only the public key is injected.
#   The target is always direct - a managed instance has no shell.
#   ⚠ MongoDB is direct-only: transx-ex requires both sides to use the same
#     accessType, and the matrix stops before creating anything if you ask for
#     mongodb with MODE=ssh.
MODE=direct

#   SSH key pair used in MODE=ssh, generated on first use when absent.
#   ⚠ honeybee stores the PEM ITSELF (RSA-wrapped), not a path, so the private
#     key travels in the request body. That is why private_key is in the API
#     log's masking filter.
MATRIX_SSH_KEY=.matrix-ssh/id_rsa

# --- Build limits -------------------------------------------------------------
#   A source image is ubuntu:22.04 plus an apt install, so the first build of a
#   version takes minutes where `docker pull` took seconds. It is cached per
#   version afterwards. READY_TIMEOUT covers the systemd boot plus the seed.
SRC_BUILD_TIMEOUT=900
READY_TIMEOUT=300


# ==============================================================================
# ===   T A R G E T   T R A N S P O R T   S E C U R I T Y
# ==============================================================================
#   TARGET_TLS_MODE is carried into the inline db connection centipede uses for
#   the target, and from there into transx-ex's DirectConfig.TLSMode. It is the
#   condition the MIGRATION runs under, and it is recorded with the result so a
#   PASS is read against the right terms.
#
#   Setting a cell up does NOT use it. Creating the target database
#   (tofu/{my,pg}-target) and the PostgreSQL privilege query connect on the best
#   transport the server offers - TLS when there is any, plaintext otherwise.
#   Those connections used to honour this value too, until NCP Cloud DB for
#   MySQL, which offers no TLS at all, made every one of its columns SKIP at the
#   default prefer - while transx-ex, which implements a real prefer, would have
#   migrated into it over plaintext. See tofu/my-target/provider.tf.
#
#     disable      plaintext
#     prefer       TLS if the server offers it, plaintext otherwise (default)
#     require      TLS enforced, certificate not verified
#     verify-ca    chain verified
#     verify-full  chain + hostname verified
#
#   Why prefer is the default: it encrypts wherever the server allows it and
#   still connects to a server that refuses plaintext (RDS MariaDB 11.8+, RDS
#   PostgreSQL) and to one that cannot speak TLS at all (NCP Cloud DB for
#   MySQL). One value runs every column without touching what the CSP
#   configured.
#
#   MongoDB has no prefer - a client either negotiates TLS or it does not, and
#   transx-ex rejects the value. So with prefer, mongodb cells alone run at
#   disable and every other engine stays on prefer; refusing the whole run
#   because one engine in it is mongodb would cost the other columns for
#   nothing. Set require to check mongodb over TLS - it applies to all engines.
#   The effective mode is recorded per engine in engines[].tlsMode.
#
#   verify-ca / verify-full use the system trust store only. RDS and NCP sign
#   with their own CAs, and this environment has no path to supply a bundle.
#   All five modes reach MySQL through centipede - transx-ex implements them -
#   so the migration always runs at exactly the configured mode.
TARGET_TLS_MODE=prefer

#   MongoDB authentication database for the TARGET, carried as db.authSource.
#   The managed NCP MongoDB creates its master account in admin.
MONGODB_AUTH_SOURCE=admin


# ##############################################################################
# ###   A W S        RDS: mysql | mariadb | postgresql
# ##############################################################################

# --- [CREDENTIAL] -------------------------------------------------------------
#   Stored in OpenBao secret/csp/aws and secret/db/aws, then blanked here.
#   The IAM user needs RDS permissions.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DB_PASSWORD=

# --- Region and sizing --------------------------------------------------------
#   The default VPC is used as is - there is no zone or CIDR to set, and no
#   network module on the AWS side at all.
AWS_REGION=ap-northeast-2
AWS_DB_ADMIN_USERNAME=dbadmin
AWS_DB_INSTANCE_CLASS=db.t3.micro
AWS_DB_STORAGE_GB=20

# --- Engines and versions -----------------------------------------------------
#   *_SRC_VERSIONS  rows    - what the vendor apt repository serves for jammy
#   *_DST_VERSIONS  columns - managed engine versions
#
#   ⚠ SOURCE versions are NOT Docker Hub tags. The source image installs the
#     server from the vendor's apt repository, so only what that repository
#     offers on Ubuntu 22.04 can be built, and a version outside the list fails
#     during `docker build`:
#
#       mysql       8.0 · 8.4
#       mariadb     10.6 · 10.11 · 11.4 · 11.8
#       postgresql  13 · 14 · 15 · 16 · 17
#       mongodb     6.0 · 7.0 · 8.0
#
#   AWS has no managed MongoDB this matrix can use: DocumentDB exposes no public
#   endpoint, and EC2 self-hosting is out of scope. Run mongodb on NCP.
#
#   Each TARGET version is checked with a real `tofu plan` before anything is
#   created - that catches both "this region does not offer it" and "it cannot
#   be ordered with this instance class". To see the catalogue:
#       ./scripts/aws-db-versions.sh
#       ./scripts/aws-db-versions.sh --write     # write it into *_DST_VERSIONS
#
#   ⚠ One target version = one RDS instance (5-30 min, billed while it exists).
AWS_ENGINES="mysql mariadb postgresql"
AWS_MYSQL_SRC_VERSIONS="8.0 8.4"
AWS_MYSQL_DST_VERSIONS="8.0.46 8.4.11"
AWS_MARIADB_SRC_VERSIONS="10.6 10.11 11.4 11.8"
AWS_MARIADB_DST_VERSIONS="10.6.28 11.8.9"
AWS_POSTGRESQL_SRC_VERSIONS="14 15 16"
AWS_POSTGRESQL_DST_VERSIONS="14.24 15.19 16.15"

# --- Plaintext connections on the target --------------------------------------
#   csp-default  leave the CSP setting alone (default). MariaDB 11.8+ sets
#                require_secure_transport=ON and PostgreSQL sets rds.force_ssl=1;
#                TARGET_TLS_MODE connects on those terms.
#   off          attach a parameter group allowing plaintext - the escape hatch
#                for seeing what happens when TLS is genuinely unavailable.
#
#   csp-default is the default because a PASS obtained with the CSP's own
#   setting switched off does not answer the question the matrix is asked.
#   The mode used is recorded in the result JSON as secureTransport.
AWS_TARGET_SECURE_TRANSPORT=csp-default


# ##############################################################################
# ###   N C P        Cloud DB: mysql | postgresql | mongodb
# ##############################################################################

# --- [CREDENTIAL] -------------------------------------------------------------
#   Stored in OpenBao secret/csp/ncp and secret/db/ncp, then blanked here.
#   Issue the keys at: Portal > My Page > Manage Authentication Key.
#   The password rules are enforced by register-creds.sh BEFORE anything is
#   provisioned, because NCP otherwise reports the violation as a failed
#   creation about 30 minutes later:
#     - 8 to 20 characters
#     - at least one letter, one digit and one special character
#     - allowed:   ~ ! @ # $ % ^ * ( ) - _ = [ ] { } ; : , . < > ?
#     - forbidden: ` & + \ " ' /  and whitespace
#     - example:   Cent1pede!2024
NCP_ACCESS_KEY=
NCP_SECRET_KEY=
NCP_DB_PASSWORD=

# --- Region, zone, network ----------------------------------------------------
#   NCP has no default VPC, so a VPC and one PUBLIC subnet are created. One
#   subnet is enough because the managed databases are created with is_ha=false,
#   and it must be PUBLIC for a public domain to be requestable.
NCP_REGION=KR
NCP_ZONE=KR-2
NCP_VPC_CIDR=10.20.0.0/16
NCP_DB_ADMIN_USERNAME=dbadmin

# --- Engines and versions -----------------------------------------------------
#   NCP has no managed MariaDB (self-hosted docker only, out of scope).
#
#   ⚠ TARGET versions must be full strings - 8.0.36, never 8.0. The provider
#   normalises state to the version the API reports and engine_version_code
#   forces replacement, so a partial value schedules another 30-minute
#   re-creation on every later plan. Caught at plan time by tofu/ncp/rdbms.
#       ./scripts/ncp-db-versions.sh
#
#   SOURCE versions follow the apt table in the AWS section above.
NCP_ENGINES="mysql postgresql mongodb"
NCP_MYSQL_SRC_VERSIONS="8.0 8.4"
NCP_MYSQL_DST_VERSIONS="8.0.36 8.4.8"
NCP_POSTGRESQL_SRC_VERSIONS="13 14 15"
NCP_POSTGRESQL_DST_VERSIONS="13.21 14.22 15.17 16.14"
NCP_MONGODB_SRC_VERSIONS="6.0 7.0"
NCP_MONGODB_DST_VERSIONS="6.0.27 7.0.28"

# ==============================================================================
# ===   P O S T G R E S Q L   T A R G E T
# ==============================================================================
#   PG_TARGET_TEMPLATE - which template a cell's target database is copied from.
#   A new database inherits that template's public schema ACL, which is exactly
#   what the creation probe measures: a fresh database per cell re-creates
#   whatever restriction the template carries.
#
#     template1  what CREATE DATABASE uses when nobody says otherwise (default).
#                An operator or the CSP may have altered it, and that is the
#                point - a cell database then looks like one the operator would
#                have made on that server, so the verdict describes the server
#                as they actually find it.
#     template0  the pristine one, still carrying the engine defaults. Set it to
#                compare: on a server where the public grant was revoked the two
#                can disagree, and which one differs says where the revocation
#                was applied.
#
#   ⚠ AWS only. On NCP the managed service creates databases through its own API
#     and takes no template argument.
PG_TARGET_TEMPLATE=template1


# ==============================================================================
# ===   R U N   C O N T R O L
# ==============================================================================

# ONLY_ENGINES - empty means all of <CSP>_ENGINES
ONLY_ENGINES=

# ONLY_CELLS - run selected cells only. "src:dst" or "engine:src:dst", space
#   separated.  e.g. ONLY_CELLS="8.0:8.4"   ONLY_CELLS="mariadb:10.6:10.11"
#   A column filtered out entirely creates no instance.
ONLY_CELLS=

#   1 stops the matrix at the first FAIL
STOP_ON_FAIL=0
#   1 keeps a failed cell's source container for debugging
KEEP_ON_FAIL=0
#   1 keeps the managed instances - THEY KEEP BILLING
KEEP_INSTANCE=0
#   1 reuses an instance a previous run left in tofu state
REUSE_INSTANCE=1

# TARGET_REACH_TIMEOUT - TCP reachability of the target endpoint, in seconds.
#   There is no timeout for instance creation: tofu apply is synchronous.
TARGET_REACH_TIMEOUT=180

# DELETE_RETRIES / DELETE_RETRY_WAIT - destroy is retried this many times, this
#   many seconds apart. NCP answers some delete calls with 500 / returnCode 1300
#   while it is still releasing a server, and the same call then succeeds.
DELETE_RETRIES=1
DELETE_RETRY_WAIT=60

#   1 does not wait for a keypress between cells
NO_PAUSE=1
#   1 writes neither .log file. The result JSON is still written, so logs/ is
#   created either way (and by mkdir -p, so a LOG_DIR several levels deep works).
NO_LOG=0

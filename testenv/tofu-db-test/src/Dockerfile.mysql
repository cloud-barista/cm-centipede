# Matrix source image - MySQL on Ubuntu 22.04 with systemd.
#
# Why systemd rather than the official mysql image: the container has to look
# like a machine, not a process. `systemctl` works, sshd is a unit, and the
# database is a service that starts at boot - which is what an on-premises source
# is, and what anything deployed onto it later expects to find.
#
# The row axis of the matrix is DB_VERSION, resolved against the vendor apt
# repository. That is narrower than Docker Hub tags: only what MySQL ships for
# jammy can be built (8.0, 8.4), and a version outside that fails here, at build
# time, rather than after a container is already running.
#
# Readiness is one signal: matrix-init.service reaching "active" means the server
# is up, the account exists and the seed is loaded.
#
# Requires --privileged, --cgroupns=host and /sys/fs/cgroup mounted rw.
# Local testing only, never production.
FROM ubuntu:22.04

ARG DB_VERSION=8.0
ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=Asia/Seoul

RUN apt-get update && apt-get install -y --no-install-recommends \
        systemd systemd-sysv dbus \
        openssh-server sudo ca-certificates curl wget gnupg lsb-release \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

# The repository line is written directly, the way Dockerfile.postgresql writes
# the PGDG one, rather than through the mysql-apt-config deb. That deb picks the
# component from a debconf answer and silently keeps going when the answer names
# no component - apt then finds no vendor mysql-server, resolves the name against
# Ubuntu's archive instead, and the image ends up holding 8.0 whatever
# DB_VERSION said. Naming the component here makes a wrong one a 404 at build
# time, and drops the expired-key (EXPKEYSIG) workaround the deb needed.
#
# The component is not "mysql-${DB_VERSION}": repo.mysql.com carries mysql-8.0,
# mysql-8.4-lts, mysql-9.7-lts and mysql-innovation, so an LTS after 8.0 has the
# suffix. The version assertion below is what actually holds this honest - it
# fails the build if what got installed is not what was asked for, whatever the
# reason.
RUN set -eux; \
    case "$DB_VERSION" in \
      8.0) component="mysql-8.0" ;; \
      *)   component="mysql-${DB_VERSION}-lts" ;; \
    esac; \
    curl -fsSL https://repo.mysql.com/RPM-GPG-KEY-mysql-2025 \
        | gpg --batch --yes --dearmor -o /usr/share/keyrings/mysql.gpg; \
    echo "deb [signed-by=/usr/share/keyrings/mysql.gpg] http://repo.mysql.com/apt/ubuntu/ jammy ${component}" \
        > /etc/apt/sources.list.d/mysql.list; \
    apt-get update; \
    apt-get install -y mysql-server; \
    apt-get clean; rm -rf /var/lib/apt/lists/*; \
    installed="$(mysqld --version)"; \
    case "$installed" in \
      *"Ver ${DB_VERSION}."*) ;; \
      *) echo "DB_VERSION=${DB_VERSION} asked for, but installed: ${installed}" >&2; exit 1 ;; \
    esac

# Units that make no sense in a container: they slow the boot and clutter the
# log, and a failed one keeps the boot from settling.
RUN find /etc/systemd/system /lib/systemd/system \
    -path '*.wants/*' \( \
    -name '*getty*' -o -name '*plymouth*' -o -name '*apt-daily*' -o \
    -name 'systemd-timesyncd*' -o -name '*udev*' \
    \) -exec rm -f {} \; 2>/dev/null || true

# Remote access, and utf8mb4 on both ends. The seed holds 4-byte UTF-8 (emoji),
# which a utf8mb3 client connection rejects with ERROR 1366.
#
# The packaged bind-address is commented out rather than just overridden.
# /etc/mysql/my.cnf includes conf.d/ first and mysql.conf.d/ second, and the
# last value read wins - so a package that ships bind-address = 127.0.0.1 in
# mysql.conf.d/mysqld.cnf beats anything written here, the server listens on
# loopback only, and the published port refuses every connection while
# matrix-init still reports active. Removing the competing lines settles it
# regardless of which directory a future package writes into.
RUN printf '[mysqld]\nbind-address = 0.0.0.0\nevent_scheduler = ON\ncharacter-set-server = utf8mb4\ncollation-server = utf8mb4_unicode_ci\n\n[client]\ndefault-character-set = utf8mb4\n\n[mysql]\ndefault-character-set = utf8mb4\n' \
        > /etc/mysql/conf.d/99-matrix.cnf \
    && find /etc/mysql -name '*.cnf' ! -name '99-matrix.cnf' -exec \
        sed -i -E 's/^([[:space:]]*(mysqlx-)?bind-address[[:space:]]*=)/#\1/' {} + \
    && mysqld --verbose --help 2>/dev/null \
        | awk '$1 == "bind-address" { print $2; exit }' | grep -qx '0.0.0.0'

COPY sql/                          /opt/matrix/sql/
COPY scripts/                      /opt/matrix/scripts/
COPY services/matrix-init.service  /etc/systemd/system/matrix-init.service

# defaults.env is what the image runs on its own; lib/source.sh bind-mounts
# /opt/matrix/matrix.env over it, per cell. See scripts/common.sh.
RUN printf 'SRC_DB=matrix_db\nDB_ROOT_PASS=testpass123\nSRC_DB_USER=centipede\nSRC_DB_PASS=centipede_pass\nMYSQL_SRC_CHARSET=utf8mb4\nMYSQL_SRC_COLLATION=utf8mb4_general_ci\n' \
        > /opt/matrix/defaults.env \
    && chmod +x /opt/matrix/scripts/*.sh \
    && cp /opt/matrix/scripts/init-mysql.sh /opt/matrix/init.sh \
    && chmod +x /opt/matrix/init.sh

# sshd is a unit, so MODE=ssh needs nothing started by hand - lib/source.sh only
# writes the public key in. Password login stays on for interactive debugging.
RUN mkdir -p /var/run/sshd /root/.ssh \
    && chmod 700 /root/.ssh \
    && sed -i 's/^#*PasswordAuthentication.*/PasswordAuthentication yes/' /etc/ssh/sshd_config \
    && sed -i 's/^#*PermitRootLogin.*/PermitRootLogin yes/' /etc/ssh/sshd_config \
    && echo 'root:testpass123' | chpasswd \
    && echo 'root ALL=(ALL) NOPASSWD:ALL' > /etc/sudoers.d/root-nopasswd \
    && chmod 0440 /etc/sudoers.d/root-nopasswd

RUN systemctl enable mysql.service matrix-init.service ssh.service

STOPSIGNAL SIGRTMIN+3
CMD ["/lib/systemd/systemd", "--system"]

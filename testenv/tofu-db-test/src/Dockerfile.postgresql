# Matrix source image - PostgreSQL on Ubuntu 22.04 with systemd.
#
# Why systemd rather than the official postgres image: the container has to look
# like a machine, not a process. `systemctl` works, sshd is a unit, and the
# database is a service that starts at boot - which is what an on-premises source
# is, and what anything deployed onto it later expects to find.
#
# The row axis of the matrix is DB_VERSION, resolved against the PGDG apt
# repository (13 through 17 for jammy). A version outside that fails here, at
# build time.
#
# Readiness is one signal: matrix-init.service reaching "active" means the server
# is up, the account exists and the seed is loaded.
#
# Requires --privileged, --cgroupns=host and /sys/fs/cgroup mounted rw.
# Local testing only, never production.
FROM ubuntu:22.04

ARG DB_VERSION=14
ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=Asia/Seoul

RUN apt-get update && apt-get install -y --no-install-recommends \
        systemd systemd-sysv dbus \
        openssh-server sudo ca-certificates curl wget gnupg lsb-release \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

RUN curl -fsSL https://www.postgresql.org/media/keys/ACCC4CF8.asc \
        | gpg --batch --yes --dearmor -o /usr/share/keyrings/postgresql.gpg \
    && echo "deb [signed-by=/usr/share/keyrings/postgresql.gpg] https://apt.postgresql.org/pub/repos/apt jammy-pgdg main" \
        > /etc/apt/sources.list.d/pgdg.list \
    && apt-get update && apt-get install -y postgresql-${DB_VERSION} \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

# Units that make no sense in a container: they slow the boot and clutter the
# log, and a failed one keeps the boot from settling.
RUN find /etc/systemd/system /lib/systemd/system \
    -path '*.wants/*' \( \
    -name '*getty*' -o -name '*plymouth*' -o -name '*apt-daily*' -o \
    -name 'systemd-timesyncd*' -o -name '*udev*' \
    \) -exec rm -f {} \; 2>/dev/null || true

# Remote access. The config directory is found rather than built from
# DB_VERSION, so a packaging change in a future release does not silently miss.
RUN PG_DIR=$(find /etc/postgresql -name postgresql.conf | head -1 | xargs dirname) \
    && sed -i "s/^#*listen_addresses.*/listen_addresses = '*'/" "${PG_DIR}/postgresql.conf" \
    && echo "host all all 0.0.0.0/0 md5" >> "${PG_DIR}/pg_hba.conf"

COPY sql/                          /opt/matrix/sql/
COPY scripts/                      /opt/matrix/scripts/
COPY services/matrix-init.service  /etc/systemd/system/matrix-init.service

RUN printf 'SRC_DB=matrix_db\nDB_ROOT_PASS=testpass123\nSRC_DB_USER=centipede\nSRC_DB_PASS=centipede_pass\nPOSTGRESQL_SRC_ENCODING=UTF8\nPOSTGRESQL_SRC_LOCALE=\n' \
        > /opt/matrix/defaults.env \
    && chmod +x /opt/matrix/scripts/*.sh \
    && cp /opt/matrix/scripts/init-postgresql.sh /opt/matrix/init.sh \
    && chmod +x /opt/matrix/init.sh

RUN mkdir -p /var/run/sshd /root/.ssh \
    && chmod 700 /root/.ssh \
    && sed -i 's/^#*PasswordAuthentication.*/PasswordAuthentication yes/' /etc/ssh/sshd_config \
    && sed -i 's/^#*PermitRootLogin.*/PermitRootLogin yes/' /etc/ssh/sshd_config \
    && echo 'root:testpass123' | chpasswd \
    && echo 'root ALL=(ALL) NOPASSWD:ALL' > /etc/sudoers.d/root-nopasswd \
    && chmod 0440 /etc/sudoers.d/root-nopasswd

RUN systemctl enable postgresql.service matrix-init.service ssh.service

STOPSIGNAL SIGRTMIN+3
CMD ["/lib/systemd/systemd", "--system"]

# Credentials - never committed.
#   The only secret in here is the local MinIO source account, but the file also
#   carries endpoints and namespace names that are worth keeping to yourself.
#   chmod 600.
.env
.env.bak

# Run output. The directory is created at run time (os-matrix.sh mkdir -p's it
# outside the NO_LOG check, because the result JSON is written there either way),
# so there is nothing to keep in git.
logs/

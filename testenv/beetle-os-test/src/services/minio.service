[Unit]
Description=MinIO Object Storage Server
After=network.target
Documentation=https://min.io/docs/minio/linux/index.html

[Service]
Type=notify
User=root
Group=root

# The root account comes from /opt/matrix/matrix.env, the per-run settings file
# lib/source.sh writes from .env and bind-mounts in. EnvironmentFile= is read
# when the unit starts, not when it loads, and the bind mount is in place before
# systemd starts anything - so the server runs on the .env pair, and init-minio.sh
# reads the very same file. Nothing is baked in: without matrix.env the unit
# fails to start rather than come up on a password nobody chose.
EnvironmentFile=/opt/matrix/matrix.env
Environment="MINIO_VOLUMES=/data/minio"
Environment="MINIO_OPTS=--console-address :9001"

ExecStartPre=/bin/mkdir -p /data/minio
ExecStart=/usr/local/bin/minio server $MINIO_VOLUMES $MINIO_OPTS

Restart=on-failure
RestartSec=5
LimitNOFILE=65536

StandardOutput=journal
StandardError=journal
SyslogIdentifier=minio

[Install]
WantedBy=multi-user.target

# ==============================================================================
# Environment for the object storage migration matrix (beetle-os-test)
# ------------------------------------------------------------------------------
#   1) cp .env.example .env && chmod 600 .env
#   2) Fill in [PROVISIONER], [MIGRATION STACK] and the region for each CSP you use.
#   3) ./scripts/os-support.sh     (optional) is everything registered
#   4) ./scripts/os-matrix.sh
#
#   Precedence:  CLI option > real shell variable > .env > script default
#
#   WHAT THIS ENVIRONMENT DOES
#     The source is a container this folder builds - Ubuntu 22.04 with systemd
#     and MinIO, seeded with six buckets, playing the on-premises role. The target
#     is a managed bucket created with cm-beetle. Every (source bucket x CSP) pair
#     runs as one cell: cm-honeybee inspects the bucket, cm-centipede plans,
#     migrates and validates.
#
#   NO CSP KEYS LIVE HERE. cb-tumblebug holds them, registered once by the
#   deployments stack (cd ../.. && make up && make init). This folder only needs
#   the connection to exist under the name <csp>-<region>. The target bucket is
#   reached through cb-tumblebug's ObjectStorage API, so no S3 key for the target
#   exists anywhere in this folder either - the only credential below is the
#   local MinIO source account.
#
#   NOT SHARED WITH beetleenv, beetle-db-test, tofuenv OR dockerenv. Namespace,
#   container name, resource prefix and published ports all differ, so they can
#   all be up at once, and nothing here is read from those folders.
# ==============================================================================


# ==============================================================================
# ===   S H A R E D
# ==============================================================================

# --- Naming -------------------------------------------------------------------
#   Every target bucket is named <prefix>-<csp>-os-<source bucket>:
#     cpbos-aws-os-raw-data, cpbos-ncp-os-images
#
#   ⚠ The name is the record. There is no local state file: --cleanup finds this
#     matrix's buckets by listing the namespace and matching this prefix, so
#     changing it mid-run orphans whatever the old prefix named.
#
#   ⚠ This is a cb-tumblebug id, not the bucket name in the CSP. cb-tumblebug
#     generates that from a uid of its own (src/core/resource/objectStorage.go),
#     which is why there is no bucket-name key here and why S3's global namespace
#     is not something this folder has to think about.
#
#   2-6 lowercase characters. Keep it distinct from beetleenv's cpbt and
#   beetle-db-test's cpbdb.
MATRIX_NAME_PREFIX=cpbos

#   The cb-tumblebug namespace every migration call needs. This folder's own -
#   --cleanup deletes it at the end when it is empty. A normal run leaves it.
MATRIX_NS=cpbos01


# ==============================================================================
# ===   P R O V I S I O N E R        cm-beetle + cb-tumblebug
# ==============================================================================
#   Both must already be running, together with cb-spider. This environment
#   starts none of them:
#     cd ../.. && make up && make init
#
#   Every call about a resource goes to cm-beetle. cb-tumblebug is addressed
#   directly in exactly two places, each one a thing beetle cannot do:
#     - the namespace   (beetle's namespace routes are commented out)
#     - the connection catalogue

#   BEETLE_URL must include the /beetle path prefix.
BEETLE_URL=http://localhost:8056/beetle
BEETLE_USERNAME=default
BEETLE_PASSWORD=default

TUMBLEBUG_URL=http://localhost:1323/tumblebug
TUMBLEBUG_USERNAME=default
TUMBLEBUG_PASSWORD=default

#   There is no BEETLE_OS_CSPS list to keep in step here. Which CSPs can hold a
#   managed bucket is read at run time from
#     GET /recommendation/middleware/objectStorage/support
#   and OS_CSPS is checked against it before anything is created.
#   ./scripts/os-support.sh prints the same answer on its own.

#   cm-beetle throttles its cb-tumblebug calls and answers a 503 with Retry-After
#   when there is no room. That is "in a moment", not a failure, so it is retried.
MATRIX_RATE_LIMIT_RETRIES=3


# ==============================================================================
# ===   M I G R A T I O N   S T A C K        cm-honeybee + cm-centipede
# ==============================================================================
#   Both servers must already be running. This environment starts neither.
#   Step 1 of every run checks them before a single bucket is created.

HB_BASE=http://localhost:8081/honeybee

#   cm-centipede requires BasicAuth on every call.
CP_BASE=http://localhost:8085/centipede
CP_USER=default
CP_PASS=default

# --- honeybee bookkeeping -----------------------------------------------------
#   One SourceGroup holds every source connection this matrix registers. It is
#   created with type "minio" and provider_name "onprem" - honeybee's object
#   storage import refuses any other type in as many words.
#
#   ⚠ There is one ConnectionInfo per source bucket, named <group>-<bucket>-src,
#     because honeybee stores exactly one bucket's inspect result per connection
#     (SavedObjectStorageInfo is keyed by connection id). Each bucket is
#     inspected once per run and the result is reused by every CSP column.
HB_SOURCE_GROUP=cpbos-matrix

# --- centipede bookkeeping ----------------------------------------------------
#   Migration.Name carries a unique index, so each cell gets
#   <prefix>-<csp>-<bucket>-<timestamp>.
MIGRATION_PREFIX=cpbos

#   KEEP_MIGRATION=1 leaves the migration records in centipede's database so a
#   cell can be re-read afterwards (GET /migration/<id>/logs). 0 deletes each
#   record once its verdict has been written to the result JSON.
KEEP_MIGRATION=1

#   centipede's polling. A bucket transfer of this seed settles in seconds; the
#   timeouts are generous so a slow CSP does not read as a failure.
POLL_INTERVAL=5
MIGRATION_TIMEOUT=1800
VALIDATION_TIMEOUT=600

#   GET /migration/{id}/logs is paginated (default 20, max 100 per page). The
#   matrix walks to the end rather than reading one page. An object storage cell
#   logs one entry per bucket, so this rarely matters.
CP_LOG_PAGE_SIZE=100
CP_LOG_MAX_PAGES=50


# ==============================================================================
# ===   T H E   M A T R I X        rows = bucket, columns = CSP
# ==============================================================================

# --- Columns: the CSPs to run -------------------------------------------------
#   Only what is named here is migrated. Each name is checked against cm-beetle's
#   own support matrix before anything is created, so a CSP beetle cannot hold a
#   bucket on stops the run rather than failing halfway through.
OS_CSPS="aws ncp"

# --- Rows: the source buckets -------------------------------------------------
#   These are both what the source container seeds and what the matrix migrates.
#   A name outside the list below has no seed function in src/scripts/init-minio.sh
#   and fails the image's init rather than producing an empty bucket:
#
#     raw-data        8 objects   CSV, JSONL, and the UTF-8 canary
#     processed-data  2 objects   JSON aggregate reports
#     images          9 objects   binary (50KB x6, 100KB x3)
#     documents       8 objects   text
#     backups         5 objects   binary (200KB x4, 500KB x1)
#     logs            4 objects   text
#
#   Trimming this list makes the run shorter AND the seed cheaper - a bucket left
#   out is never built.
#
#   ⚠ Whole buckets are migrated. There is no prefix setting: a beetleObjectStorage
#     destination has no prefix of its own, so a sub-prefix would be flattened onto
#     the target bucket's root.
OS_SRC_BUCKETS="raw-data processed-data images documents backups logs"


# ==============================================================================
# ===   S O U R C E        the MinIO container
# ==============================================================================
#   One container serves the whole run - unlike the managed-DB matrix, where the
#   source is rebuilt per cell because the row axis is its version.

#   How cm-honeybee reaches the source container's published port.
#   ⚠ If honeybee runs in a container, 127.0.0.1 points at honeybee itself. Use the
#     docker bridge address (often 172.17.0.1) or the host's LAN address.
HOST_IP=127.0.0.1

#   Published ports. The 33xxx band is this folder's own: beetle-db-test uses
#   31xxx, dockerenv 32xxx and 39xxx, tofu-db-test 36xxx.
MINIO_SRC_API_PORT=33900
MINIO_SRC_CONSOLE_PORT=33901
MINIO_SRC_SSH_PORT=33922

#   The MinIO root account, which is also what honeybee authenticates with.
#   ⚠ These are baked into src/services/minio.service as Environment=, because
#     systemd reads a unit's environment when the unit loads and would otherwise
#     ignore anything written here. Changing them means editing that unit and the
#     Dockerfile's defaults.env together and deleting the cached image; the run
#     refuses to start on a mismatch rather than failing later as a 403.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123

#   Empty takes whatever the MinIO release channel serves today. Pin it - a
#   RELEASE tag such as RELEASE.2025-04-22T22-12-26Z - when a result has to be
#   reproducible. Changing it changes the image tag, so the image is rebuilt.
MINIO_VERSION=

#   The first image build downloads Ubuntu packages plus the MinIO server and
#   client, and the seed writes ~1.9 MB of objects.
SRC_BUILD_TIMEOUT=900
READY_TIMEOUT=300


# ==============================================================================
# ===   C S P        one block per CSP named in OS_CSPS
# ==============================================================================
#   The region is all a bucket needs. There is no zone, no vNet and no subnet:
#   object storage sits outside the VPC, so this matrix creates no network at all.
#   The region has to match the one the connection was registered under, because
#   cm-beetle builds the connection name as <csp>-<region>.

# --- AWS ----------------------------------------------------------------------
AWS_REGION=ap-northeast-2

# --- NCP ----------------------------------------------------------------------
#   NCP's region ids are upper case in cloudinfo.yaml. The connection name is
#   lower-cased as a whole (ncp-kr), which the scripts do for you.
NCP_REGION=KR


# ==============================================================================
# ===   R U N   C O N T R O L
# ==============================================================================
#   All of these have a CLI equivalent, which wins.

#   Subsets. Empty means "everything in OS_CSPS / OS_SRC_BUCKETS".
ONLY_CSPS=
ONLY_BUCKETS=
#   Individual cells, as "<csp>:<bucket>" - e.g. "aws:raw-data ncp:images"
ONLY_CELLS=

#   Stop at the first FAIL instead of finishing the table.
STOP_ON_FAIL=0

#   Keep a failed cell's target bucket for inspection.
#   ⚠ It holds whatever the transfer had already written. An object storage
#     migration has no rollback - dbmsOnFailure is DBMS-only - so this is partial
#     data, not an empty bucket.
KEEP_ON_FAIL=0

#   Keep every target bucket at the end. They hold the migrated objects and are
#   charged for what they hold. Reclaim with --cleanup.
KEEP_BUCKET=0

#   Keep the MinIO source container running after the matrix finishes, so its
#   buckets can be inspected by hand.
KEEP_SOURCE=0

#   Keep the cb-tumblebug namespace even when --cleanup empties it. A normal run
#   never deletes it; only --cleanup does, and only when it is empty.
KEEP_NAMESPACE=0

#   Waiting for cm-beetle to create a bucket, and how often the async request is
#   polled. Seconds, not minutes - a bucket is not an instance.
BUCKET_TIMEOUT=300
BUCKET_POLL_INTERVAL=5

#   cb-tumblebug answers "deletion unconfirmed" while the CSP is still releasing
#   a bucket. Retried this many times before the forced delete is tried.
DELETE_RETRIES=3
DELETE_RETRY_WAIT=30

#   NO_PAUSE=0 stops after each cell for a keypress. NO_LOG=1 writes no .log
#   files (the result JSON is still written).
NO_PAUSE=1
NO_LOG=0

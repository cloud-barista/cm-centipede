# ==============================================================================
# beetleenv/.env  —  copy this file to .env and fill it in
#
#     cp .env.example .env && chmod 600 .env
#     ./scripts/up.sh
#
# THIS FILE IS A STORE, NOT AN INTAKE FORM.
# There is no OpenBao here and nothing is blanked after the first run: the only
# secret beetleenv holds is the RDBMS admin password, and every "create a
# database" call re-sends it. preflight() refuses to run while the file is
# readable by anyone but its owner.
#
# THERE ARE NO CSP CREDENTIALS HERE AT ALL.
# cb-tumblebug holds them, and beetleenv never sees them: the connections are
# already registered there, and beetleenv only asks cm-beetle to use them.
#
# THERE ARE NO ENGINE VERSIONS, INSTANCE SPECS, STORAGE TYPES, VM IMAGES OR VM
# SPECS HERE EITHER.
# cm-beetle's recommendation APIs resolve all of those against the live CSP
# catalogue at provision time. What you describe below is the SOURCE side - "the
# database we are migrating had 2 vCPU and 100GB" - and beetle picks the target.
# Changing a region therefore needs no lookup of anything.
# ==============================================================================

# ── cm-beetle (assumed to be already running elsewhere) ───────────────────────
# BEETLE_URL must include the /beetle path prefix.
BEETLE_URL=http://localhost:8056/beetle
BEETLE_USERNAME=default
BEETLE_PASSWORD=default

# ── cb-tumblebug ──────────────────────────────────────────────────────────────
# Used for exactly one thing: creating and deleting the namespace. cm-beetle has
# no namespace API - the routes exist in pkg/api/rest/server.go but are commented
# out - while every migration call fails on a namespace that is not there.
# Every other call beetleenv makes goes through beetle.
TUMBLEBUG_URL=http://localhost:1323/tumblebug
TUMBLEBUG_USERNAME=default
TUMBLEBUG_PASSWORD=default

# ── Namespace and naming ──────────────────────────────────────────────────────
# The namespace every resource is created in, and the only place its name is
# decided. up.sh creates it; nothing ever deletes it.
#
# cb-tumblebug uses this string verbatim as the namespace id, so it is what
# appears in every API path: /beetle/migration/ns/<here>/rdbms
#
# 2-30 characters, lower case letters, digits and hyphens, starting with a letter
# and not ending in a hyphen. The first and last of those are tumblebug's own
# rule (CheckString); the rest is beetleenv keeping the name easy to read in
# URLs and logs.
#
# It is independent of BEETLEENV_NAME_PREFIX below: several environments can
# share one namespace as long as their prefixes differ, or each can have its own.
BEETLEENV_NS=cpbt01

# "centipede beetle". Every resource beetleenv creates is <prefix>-<csp>-<what>:
#   cpbt-aws-vnet, cpbt-aws-subnet-1, cpbt-aws-subnet-2, cpbt-aws-sg
#   cpbt-aws-db-mysql, cpbt-aws-db-mariadb, cpbt-aws-bucket
#   cpbt-aws-infra, cpbt-aws-sshkey
# The CSP is in the name because one namespace holds every CSP's resources, and a
# cb-tumblebug resource id is unique per namespace rather than per connection.
# 2-10 lower-case letters and digits, starting with a letter: ^[a-z][a-z0-9]{1,9}$
# No hyphen, so that <prefix>-<csp>- can never also be the start of another
# prefix's names.
# deprovision.sh treats everything named <prefix>-<csp>-* as ours and leaves
# everything else alone, so do not point two setups at one namespace with the
# same prefix.
BEETLEENV_NAME_PREFIX=cpbt

# Active CSPs, space separated. up.sh, status.sh and "deprovision.sh all" walk
# this list.
# Quote it - .env is sourced by the shell, so an unquoted value with spaces in it
# is read as a command.
BEETLEENV_CSPS="aws ncp"

# Source CIDR opened on the shared security group, for SSH and the database port.
BEETLEENV_ALLOWED_CIDR=0.0.0.0/0


# ==============================================================================
# AWS
# ==============================================================================
BEETLEENV_AWS_REGION=ap-northeast-2
BEETLEENV_AWS_ZONE=ap-northeast-2a
# A SECOND zone, and it must differ from the first: every managed RDBMS wants
# subnets in two availability zones. up.sh refuses two identical values.
BEETLEENV_AWS_ZONE2=ap-northeast-2c

# The vNet the VM and the databases share. The two /24 subnets are derived from
# it (10.0.1.0/24 and 10.0.2.0/24); set _SUBNET1_CIDR and _SUBNET2_CIDR
# explicitly for anything that is not a /16.
BEETLEENV_AWS_VNET_CIDR=10.0.0.0/16
# BEETLEENV_AWS_SUBNET1_CIDR=
# BEETLEENV_AWS_SUBNET2_CIDR=

# ── Managed RDBMS ────────────────────────────────────────────────────────────
# One instance is created per engine, named cpbt-db-<engine>.
# cm-beetle can create mysql and mariadb today. postgresql and mongodb are
# refused with a message rather than silently substituted - see the note at the
# bottom of this file.
BEETLEENV_AWS_DB_ENGINES="mysql mariadb"

# The one secret in this file. Kept here because it is re-sent on every call.
BEETLEENV_AWS_DB_PASSWORD=
BEETLEENV_AWS_DB_ADMIN_USERNAME=dbadmin

# Reachable from outside the vNet. Leave it true unless cm-centipede is being run
# from inside the same network - the VM created here is, the machine you are
# reading this on is probably not.
#
# NCP is the CSP where this is not the whole story: it has no public endpoint
# until a public domain is issued from the console, which no API can do. The flag
# is still carried into the create call there - see ./scripts/ncp-db-domain.sh.
BEETLEENV_AWS_DB_PUBLIC_ACCESS=true

# Automated backups on the created instance, in days of retention. 0 turns them
# off, which is the default: these instances exist to be migrated from and then
# deleted, so a backup is cost with no reader. Raise it to keep one.
#
# Written into the create call rather than left to beetle, which answers 7 to
# every recommendation - a preference of 0 is a Go zero value and reads to it as
# "no preference" rather than as "none".
BEETLEENV_AWS_DB_BACKUP_RETENTION_DAYS=0

# The SOURCE database being migrated. beetle sizes the target from these, so
# they are the knob for "give me something bigger", not an instance type.
BEETLEENV_AWS_DB_SRC_VCPU=2
BEETLEENV_AWS_DB_SRC_MEMORY_MB=4096
BEETLEENV_AWS_DB_SRC_STORAGE_GB=100
# One key per engine, because MySQL and MariaDB number their releases in
# unrelated ranges - 8.0 means nothing to MariaDB, 10.11 means nothing to MySQL -
# and a shared key would be sent as the source version for both. Pinning one
# therefore leaves the others on automatic selection.
#
# Empty means beetle picks the newest supported version for that engine. The
# values below are pinned instead, so a run today and a run next month build the
# same thing. Empty a key to get automatic selection back.
#
# Write a version exactly as ./scripts/catalog.sh <csp> rdbms lists it - a value
# that matches nothing is answered with a warning and a version of beetle's
# choosing, not an error. Note that the CSPs do not agree on the format: AWS
# reports major.minor, NCP reports the full string, which is why the NCP block
# below looks different.
BEETLEENV_AWS_DB_SRC_ENGINE_VERSION_MYSQL=8.4
BEETLEENV_AWS_DB_SRC_ENGINE_VERSION_MARIADB=10.11

# ── VM ───────────────────────────────────────────────────────────────────────
# The SOURCE machine. beetle answers with a concrete spec and image for the
# region, which is why there is no VM image or VM spec key anywhere here.
BEETLEENV_AWS_VM_SRC_VCPU=2
BEETLEENV_AWS_VM_SRC_MEMORY_GB=4
BEETLEENV_AWS_VM_SRC_DISK_GB=20

# "<os id> <version id>", lower case - NOT a pretty name. beetle searches
# cb-tumblebug's image catalogue with exactly this string plus the architecture
# below, so "Ubuntu 22.04.3 LTS" finds nothing while "ubuntu 22.04" finds the
# image. The value must match an osType the catalogue holds:
#   ./scripts/catalog.sh aws vmimage    prints what beetle searched with, and
#                                       what to run to list the alternatives
BEETLEENV_AWS_VM_SRC_OS="ubuntu 22.04"
BEETLEENV_AWS_VM_SRC_ARCH=x86_64

# The account to log in to the VM as. Only conn-info.sh --ssh reads it, and only
# because cb-tumblebug leaves nodeUserName null on a plain VM read - it is filled
# in by ?option=accessinfo, which cm-beetle does not expose. Empty falls back to
# cb-user, which is what cb-tumblebug creates on every VM it provisions; set it
# only for an image that ships a different account.
# BEETLEENV_AWS_VM_USER=cb-user


# ==============================================================================
# NCP (Naver Cloud Platform)
# ==============================================================================
BEETLEENV_NCP_REGION=KR
BEETLEENV_NCP_ZONE=KR-1
BEETLEENV_NCP_ZONE2=KR-2
BEETLEENV_NCP_VNET_CIDR=10.0.0.0/16

# NCP has no managed MariaDB, so it is not in the list. Asking for it anyway is
# stopped before anything is created: beetle would answer with a mysql
# recommendation and a warning, and provision.sh refuses that substitution.
BEETLEENV_NCP_DB_ENGINES="mysql"

# NCP enforces its own password rule: 8-20 characters with a letter, a digit and
# one of  ~ ! @ # $ % ^ * ( ) - _ = [ ] { } ; : , . < > ?
# up.sh checks it here, because NCP only reports a violation when the database is
# created - about half an hour into the run.
BEETLEENV_NCP_DB_PASSWORD=
BEETLEENV_NCP_DB_ADMIN_USERNAME=dbadmin
# true here asks for it and gets a warning back: NCP creates the instance on its
# private domain either way, and the public one is a console action. See the AWS
# block above and ./scripts/ncp-db-domain.sh.
BEETLEENV_NCP_DB_PUBLIC_ACCESS=true
BEETLEENV_NCP_DB_BACKUP_RETENTION_DAYS=0

BEETLEENV_NCP_DB_SRC_VCPU=2
BEETLEENV_NCP_DB_SRC_MEMORY_MB=4096
BEETLEENV_NCP_DB_SRC_STORAGE_GB=100
# One key per engine - see the AWS block above. NCP has no managed MariaDB, so
# only the MySQL one is listed here.
# The full version, not "8.4": NCP reports and matches on the complete string.
BEETLEENV_NCP_DB_SRC_ENGINE_VERSION_MYSQL=8.4.6

BEETLEENV_NCP_VM_SRC_VCPU=2
BEETLEENV_NCP_VM_SRC_MEMORY_GB=4
BEETLEENV_NCP_VM_SRC_DISK_GB=20
# "<os id> <version id>", lower case - see the AWS block above.
BEETLEENV_NCP_VM_SRC_OS="ubuntu 22.04"
BEETLEENV_NCP_VM_SRC_ARCH=x86_64

# The account to log in to the VM as. Only conn-info.sh --ssh reads it, and only
# because cb-tumblebug leaves nodeUserName null on a plain VM read - it is filled
# in by ?option=accessinfo, which cm-beetle does not expose. Empty falls back to
# cb-user, which is what cb-tumblebug creates on every VM it provisions; set it
# only for an image that ships a different account.
# BEETLEENV_NCP_VM_USER=cb-user


# ==============================================================================
# Other CSPs
#
# Adding one means four keys - region, two zones and a vNet CIDR - plus the DB
# block if you want a database. Nothing else, and no script changes: which
# engines a CSP offers is read from cb-tumblebug at runtime with
#   ./scripts/catalog.sh <csp> engines
# ==============================================================================

# BEETLEENV_GCP_REGION=asia-northeast3
# BEETLEENV_GCP_ZONE=asia-northeast3-a
# BEETLEENV_GCP_ZONE2=asia-northeast3-b
# BEETLEENV_GCP_VNET_CIDR=10.0.0.0/16
# BEETLEENV_GCP_DB_ENGINES="mysql"
# BEETLEENV_GCP_DB_PASSWORD=

# BEETLEENV_AZURE_REGION=koreacentral
# BEETLEENV_AZURE_ZONE=1
# BEETLEENV_AZURE_ZONE2=2
# BEETLEENV_AZURE_VNET_CIDR=10.0.0.0/16
# BEETLEENV_AZURE_DB_ENGINES="mysql"
# BEETLEENV_AZURE_DB_PASSWORD=

# BEETLEENV_ALIBABA_REGION=ap-northeast-2
# BEETLEENV_ALIBABA_ZONE=ap-northeast-2a
# BEETLEENV_ALIBABA_ZONE2=ap-northeast-2b
# BEETLEENV_ALIBABA_VNET_CIDR=10.0.0.0/16
# BEETLEENV_ALIBABA_DB_ENGINES="mysql mariadb"
# BEETLEENV_ALIBABA_DB_PASSWORD=


# ==============================================================================
# PostgreSQL and MongoDB
#
# Neither can be created through cm-beetle today. Its managed RDBMS model
# declares dbEngine as enums:"mysql,mariadb", and its recommendation maps any
# other engine to mysql with a warning rather than refusing - so a postgresql
# entry in _DB_ENGINES would quietly produce a MySQL instance. beetleenv stops
# instead, and says why.
#
# cb-tumblebug and cb-spider already carry postgresql, so when beetle's engine
# list grows, adding it here is the only change needed on this side:
# BEETLEENV_SUPPORTED_ENGINES in scripts/lib/recommend.sh is the one constant
# that has to follow.
#
# MongoDB is further off - it is not an RDBMS, and there is no managed NoSQL
# resource anywhere in the stack yet.
# ==============================================================================

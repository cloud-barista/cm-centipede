# ==============================================================================
# Environment for the managed-DB version matrix (beetle-db-test)
# ------------------------------------------------------------------------------
#   1) cp .env.example .env && chmod 600 .env
#      This file holds the managed instance's master password in plain text.
#      The file mode is the only thing protecting it - there is no vault here.
#   2) Fill in [MIGRATION STACK], [PROVISIONER] and the section for the CSP you use.
#   3) ./scripts/aws-db-matrix.sh
#
#   Precedence:  CLI option > real shell variable > .env > script default
#
#   WHAT THIS ENVIRONMENT DOES
#     The source is a container this folder builds - Ubuntu 22.04 with systemd,
#     playing the on-premises role. The target is a managed instance created with
#     cm-beetle. Every (source version x target version) pair runs as one cell:
#     cm-honeybee collects the source, cm-centipede plans, migrates and
#     validates. One target version = one managed instance = real money.
#
#   NO CSP KEYS LIVE HERE. cb-tumblebug holds them, registered once by the
#   deployments stack (cd ../.. && make up && make init). This folder only needs
#   the connection to exist under the name <csp>-<region>.
#
#   NOT SHARED WITH THE OTHER ENVIRONMENTS IN THIS REPO. Namespace, container
#   names, resource prefix and published ports are all this folder's own, so any
#   of them can be up at once, and nothing here is read from another folder.
# ==============================================================================


# ==============================================================================
# ===   S H A R E D
# ==============================================================================

# --- Naming and inbound access ------------------------------------------------
#   Every resource is named <prefix>-<csp>-<what>:
#     cpbdb-aws-vnet, cpbdb-aws-subnet-1, cpbdb-aws-sg, cpbdb-aws-db-mysql-8-0
#
#   ⚠ The name is the record. There is no local state file: --cleanup finds this
#     matrix's instances by listing the namespace and matching this prefix, so
#     changing it mid-run orphans whatever the old prefix named.
#
#   2-6 lowercase characters, and distinct from the prefix every other
#   environment in this repo uses. The NCP managed MongoDB service_name is capped
#   at 15 characters, so a long prefix leaves no room for the version.
MATRIX_NAME_PREFIX=cpbdb

#   The cb-tumblebug namespace every migration call needs. This folder's own -
#   --cleanup deletes it at the end when it is empty.
MATRIX_NS=cpbdb01

#   Inbound CIDR opened on the engine port, in the security group this folder
#   creates. The host running the matrix and the host running cm-centipede must
#   both be inside it.
MATRIX_ALLOWED_CIDR=0.0.0.0/0


# ==============================================================================
# ===   P R O V I S I O N E R        cm-beetle + cb-tumblebug
# ==============================================================================
#   Both must already be running, together with cb-spider. This environment
#   starts none of them:
#     cd ../.. && make up && make init
#
#   Every call about a resource goes to cm-beetle. cb-tumblebug is addressed
#   directly in exactly three places, each one a thing beetle cannot do:
#     - the namespace   (beetle's namespace routes are commented out)
#     - the connection catalogue
#     - engine version lists (beetle's capability endpoint pins dbEngine=mysql,
#       so mariadb's list cannot come out of it)

#   BEETLE_URL must include the /beetle path prefix.
BEETLE_URL=http://localhost:8056/beetle
BEETLE_USERNAME=default
BEETLE_PASSWORD=default

TUMBLEBUG_URL=http://localhost:1323/tumblebug
TUMBLEBUG_USERNAME=default
TUMBLEBUG_PASSWORD=default

# --- Engines cm-beetle can create, per CSP ------------------------------------
#   Leave these commented out unless beetle has gained an engine and this folder
#   has not caught up. They override the tables in scripts/lib/beetle.sh, which
#   are the documented state of the stack:
#
#     BEETLE_ENGINES_AWS="mysql mariadb"
#     BEETLE_ENGINES_NCP="mysql"
#
#   beetle's managed-RDBMS model declares dbEngine as enums:"mysql,mariadb", and
#   for anything else it returns a mysql recommendation instead of an error - so
#   an engine outside these lists is refused before anything is created rather
#   than silently substituted.
# BEETLE_ENGINES_AWS="mysql mariadb"
# BEETLE_ENGINES_NCP="mysql"

#   cm-beetle throttles its cb-tumblebug calls and answers a 503 with Retry-After
#   when there is no room. That is "in a moment", not a failure, so it is retried.
MATRIX_RATE_LIMIT_RETRIES=3


# ==============================================================================
# ===   M I G R A T I O N   S T A C K        cm-honeybee + cm-centipede
# ==============================================================================
#   Both servers must already be running. This environment starts neither.
#   Step 1 of every run checks them before a single instance is created.

HB_BASE=http://localhost:8081/honeybee

#   cm-centipede requires BasicAuth on every call.
CP_BASE=http://localhost:8085/centipede
CP_USER=default
CP_PASS=default

# --- honeybee bookkeeping -----------------------------------------------------
#   One SourceGroup holds every source connection this matrix registers; the
#   per-engine ConnectionInfo is named <group>-<engine>-src and reused across
#   cells, since the address and port of a source container do not change with
#   its version. Collection is re-run for every cell, because the database
#   behind that endpoint has been replaced.
HB_SOURCE_GROUP=cpbdb-matrix

# --- centipede bookkeeping ----------------------------------------------------
#   Migration.Name carries a unique index, so each cell gets
#   <prefix>-<engine>-<src>-<dst>-<timestamp>.
MIGRATION_PREFIX=cpbdb

#   KEEP_MIGRATION=1 leaves the migration records in centipede's database so a
#   cell can be re-read afterwards (GET /migration/<id>/logs). 0 deletes each
#   record once its verdict has been written to the result JSON.
KEEP_MIGRATION=1

#   DBMS_ON_FAILURE - what centipede does with a target database whose item
#   failed. cleanup (default) undoes it; keep leaves the partial result in place
#   for inspection. The matrix drops the target database itself at the end of
#   every cell either way, so keep only matters while you are looking.
DBMS_ON_FAILURE=cleanup

# --- Polling ------------------------------------------------------------------
#   centipede is asynchronous: POST /migration returns immediately and the run
#   is followed by polling. MIGRATION_TIMEOUT has to cover the slowest cell, not
#   the average one.
#
#   ⚠ POLL_INTERVAL is centipede's alone. Creating a managed instance is followed
#     with RDBMS_POLL_INTERVAL further down - a migration settles in seconds and
#     an instance in tens of minutes, and one value cannot serve both.
POLL_INTERVAL=5
MIGRATION_TIMEOUT=1800
VALIDATION_TIMEOUT=600

# --- The migration log ---------------------------------------------------------
#   Every cell prints GET /migration/{id}/logs after validation. That endpoint is
#   paginated - 20 entries by default, 100 at most - so the matrix walks to the
#   end of the pages rather than reading one and quietly showing a prefix.
CP_LOG_PAGE_SIZE=100
CP_LOG_MAX_PAGES=50


# ==============================================================================
# ===   S O U R C E        containers this folder builds (the row axis)
# ==============================================================================
#   src/Dockerfile.<engine> builds Ubuntu 22.04 + systemd + the vendor apt
#   repository, so `systemctl` works, sshd is a unit and the database is a
#   service that starts at boot. src/scripts/init-<engine>.sh then creates the
#   account, the database and the seed, and matrix-init.service reaching
#   "active" is the single readiness signal the matrix waits on.
#
#   ⚠ These containers run --privileged with /sys/fs/cgroup mounted rw, which is
#     what systemd needs. Local testing only, never production.

# --- Address ------------------------------------------------------------------
#   HOST_IP is how a published container port is reached - by the matrix for its
#   readiness check, and by cm-honeybee for the source connection it registers.
#   One value serves both, but it has to satisfy the stricter of the two:
#
#     honeybee on this host       127.0.0.1 works
#     honeybee in a container     127.0.0.1 points at honeybee itself and finds
#                                 nothing; use the host's LAN address
#                                 (e.g. 172.24.78.163), which the matrix's own
#                                 check reaches just as well
HOST_IP=127.0.0.1

# --- Accounts and databases ---------------------------------------------------
#   SRC_DB_USER is the account cm-honeybee connects with; it holds every
#   privilege on the source, because a migration reads routines and triggers as
#   well as rows. DB_ROOT_PASS is the engine's own superuser, used inside the
#   container during initialization.
#
#   DST_DB is created empty inside the managed instance for every cell, through
#   cm-beetle's logical database API. TARGET_DB_CREATE below decides who makes
#   that call - cm-centipede by default.
SRC_DB_USER=centipede
SRC_DB_PASS=centipede_pass
DB_ROOT_PASS=testpass123
SRC_DB=matrix_db
DST_DB=matrix_db

# --- Who creates the target database ------------------------------------------
#   The target of this folder is named to centipede as a beetleDb reference - the
#   managed instance's namespace and id, not a host and port - so centipede can
#   resolve it through cm-beetle. Creating the target database behind such a
#   reference is something centipede does for itself, through the same cm-beetle
#   logical database API this script would otherwise call.
#
#     centipede  (default)  centipede creates it, and therefore owns it.
#                           A failed cell drops the database whole.
#     matrix                this script creates it before the plan. centipede then
#                           finds a database it did not create, so a failed cell is
#                           emptied by transx-ex's rollback and the database kept.
#
#   The difference is not only who calls: centipede's EnsureTargetDatabase reports
#   whether it created the database, and that flag picks the undo path above. Both
#   are real situations - an operator who provisions the target ahead of time gets
#   the second - so both are runnable, and the value is recorded with the result.
#
#   Either way anything left under DST_DB from a previous cell is dropped first.
#   transx-ex requires the target to exist and be empty.
#
#   ⚠ centipede must be able to reach cm-beetle for this, and for the plan at all.
#     Its own centipede.beetle.endpoint (conf/cm-centipede.yaml, or the env var
#     CENTIPEDE_BEETLE_ENDPOINT) has to name the same cm-beetle as BEETLE_URL
#     above - host and port only, centipede appends /beetle itself. Nothing in
#     this folder needed that before the target became a beetleDb reference, so it
#     is worth checking once. If centipede runs in a container, localhost there is
#     not this host.
TARGET_DB_CREATE=centipede

# --- Source character set -----------------------------------------------------
#   Used verbatim in the source CREATE DATABASE, inside the container.
#
#   There is no target counterpart, and on this path there cannot be one:
#   cm-beetle's logical database call takes a name and the admin password and
#   nothing else, so the target database follows the instance defaults. Table
#   character sets travel inside the dump's CREATE TABLE statements, and
#   centipede reports a database-level difference as a warning, not a failure.
#   Leave a value empty to take the server default.
MYSQL_SRC_CHARSET=utf8mb4
MYSQL_SRC_COLLATION=utf8mb4_general_ci
MARIADB_SRC_CHARSET=utf8mb4
MARIADB_SRC_COLLATION=utf8mb4_general_ci
POSTGRESQL_SRC_ENCODING=UTF8
POSTGRESQL_SRC_LOCALE=
MONGODB_SRC_COLLATION_LOCALE=

# --- Published host ports -----------------------------------------------------
#   The 31xxx band, chosen because it is the one nobody else in this repo uses.
#   The other test environments and check scripts already occupy 32xxx-39xxx and
#   45xxx, and several being up at once is the normal case, so these must not
#   collide. Check the neighbouring .env.example files before changing them.
MYSQL_SRC_DB_PORT=31406
MYSQL_SRC_SSH_PORT=31240
MARIADB_SRC_DB_PORT=31306
MARIADB_SRC_SSH_PORT=31230
POSTGRESQL_SRC_DB_PORT=31432
POSTGRESQL_SRC_SSH_PORT=31252
MONGODB_SRC_DB_PORT=31017
MONGODB_SRC_SSH_PORT=31270

# --- Source access mode -------------------------------------------------------
#   direct  honeybee connects to the published port
#   ssh     honeybee is registered with db_access_type=ssh-tunnel, so the dump
#           tools run inside the container. sshd is already a unit in the image,
#           so only the public key is injected.
#   The target is always direct - a managed instance has no shell.
#   ⚠ MongoDB is direct-only: transx-ex requires both sides to use the same
#     accessType, and the matrix stops before creating anything if you ask for
#     mongodb with MODE=ssh.
MODE=direct

#   SSH key pair used in MODE=ssh, generated on first use when absent.
#   ⚠ honeybee stores the PEM ITSELF (RSA-wrapped), not a path, so the private
#     key travels in the request body. That is why private_key is in the API
#     log's masking filter.
MATRIX_SSH_KEY=.matrix-ssh/id_rsa

# --- Build limits -------------------------------------------------------------
#   A source image is ubuntu:22.04 plus an apt install, so the first build of a
#   version takes minutes where `docker pull` took seconds. It is cached per
#   version afterwards. READY_TIMEOUT covers the systemd boot plus the seed.
SRC_BUILD_TIMEOUT=900
READY_TIMEOUT=300


# ==============================================================================
# ===   T A R G E T   T R A N S P O R T   S E C U R I T Y
# ==============================================================================
#   TARGET_TLS_MODE is carried as beetleDb.tlsMode on the target reference, and
#   from there into transx-ex's DirectConfig.TLSMode. It is the condition the
#   MIGRATION runs under, and it is recorded with the result so a PASS is read
#   against the right terms.
#
#   It travels on the reference because cm-beetle has nothing to say about it.
#   beetle reports where the instance is and who its admin is; a managed instance
#   offers TLS whether or not it demands it, so the choice is the caller's. That
#   field is new - before it existed a beetleDb target could only be reached in
#   plaintext, whatever this said.
#
#     disable      plaintext
#     prefer       TLS if the server offers it, plaintext otherwise (default)
#     require      TLS enforced, certificate not verified
#     verify-ca    chain verified
#     verify-full  chain + hostname verified
#
#   Why prefer is the default: it encrypts wherever the server allows it and
#   still connects to a server that refuses plaintext, and to one that cannot
#   speak TLS at all (NCP Cloud DB for MySQL). One value runs every column
#   without touching what the CSP configured.
#
#   ⚠ verify-ca and verify-full need the CSP's root, and there is nowhere here to
#     put one. The reference carries a tlsCAPem field, but this folder never fills
#     it in, so those two modes fall back to the system trust store - which does
#     not carry the RDS or NCP roots. They fail as an unknown authority.
#
#   MongoDB has no prefer - a client either negotiates TLS or it does not, and
#   transx-ex rejects the value. That fallback is unreachable here in any case:
#   a beetleDb target accepts mysql and mariadb only (see MONGODB_AUTH_SOURCE).
#   The effective mode is recorded per engine in engines[].tlsMode.
TARGET_TLS_MODE=prefer

#   MongoDB authentication database for the TARGET.
#
#   Unreachable on this path and kept only so the engine tables stay uniform. It
#   was carried as db.authSource on an inline target connection; the target is now
#   always a beetleDb reference, which has no such field - and cannot name a
#   MongoDB instance at all, because centipede's validateManagedEngine accepts
#   mysql and mariadb behind one. cb-tumblebug provisions nothing else.
MONGODB_AUTH_SOURCE=admin


# ##############################################################################
# ###   A W S        RDS: mysql | mariadb
# ##############################################################################

# --- Region, zones, network ---------------------------------------------------
#   The region must match the registered connection name <csp>-<region>:
#   aws-ap-northeast-2 is what cm-beetle's GenerateConnectionName builds, and a
#   connection registered under any other name is invisible to beetle.
#
#   ⚠ Two zones are required, and they must differ - a managed RDBMS wants
#     subnets in two of them. There is no default-VPC shortcut here: cm-beetle
#     creates the network itself, on AWS exactly as it does on NCP.
AWS_REGION=ap-northeast-2
AWS_ZONE=ap-northeast-2a
AWS_ZONE2=ap-northeast-2c

#   The two subnets are derived from the /16 by varying the third octet
#   (10.0.1.0/24, 10.0.2.0/24). For anything but a /16, set them yourself.
AWS_VNET_CIDR=10.0.0.0/16
# AWS_SUBNET1_CIDR=
# AWS_SUBNET2_CIDR=

# --- The managed instance -----------------------------------------------------
#   The admin account. The password is sent on every create and on every logical
#   database call, and cannot be read back from the CSP afterwards.
#   ⚠ It is in this file in plain text. chmod 600.
AWS_DB_PASSWORD=
AWS_DB_ADMIN_USERNAME=dbadmin

#   true unless the host running this matrix is inside the VPC.
#
#   This is carried into the create call itself, not only into the recommendation.
#   A recommendation may answer with something else - on NCP it always lowers a
#   requested true to false - and the create body is what the CSP is actually
#   asked for, so .env is what decides.
AWS_DB_PUBLIC_ACCESS=true

#   ⚠ Leave this at 0, and know why before raising it.
#
#   On RDS, automated backups are what turn BINARY LOGGING on, and with binlog on
#   MySQL refuses CREATE FUNCTION from an account without SUPER - which no managed
#   master account has:
#
#     Error 1419 (HY000): You do not have the SUPER privilege and binary logging
#     is enabled (... log_bin_trust_function_creators ...)
#
#   The seed carries a stored function on purpose, so every mysql and mariadb cell
#   fails at restore while this is non-zero. Declaring the function READS SQL DATA
#   does not help - that satisfies MySQL's other requirement, and the SUPER check
#   is separate.
#
#   cm-beetle's recommendation answers 0 with 7 (the CSP's own default), so the
#   matrix sets this on the create call itself. The only other way round it is a
#   parameter group with log_bin_trust_function_creators=1, and nothing in this
#   stack exposes parameter groups.
AWS_DB_BACKUP_RETENTION_DAYS=0

#   The source DB profile cm-beetle sizes the target from. These describe the
#   machine the source database runs on; they are not a place to name an instance
#   class, but the handle for asking for something bigger.
#
#     VCPU + MEMORY_GB  ->  dbInstanceSpec   (2 vCPU / 4 GiB gives db.t3.medium)
#     STORAGE_GB        ->  storageSize
#
#   ⚠ Memory is GiB, not MB - that is the unit cm-beetle's API takes.
AWS_DB_SRC_VCPU=2
AWS_DB_SRC_MEMORY_GB=4
AWS_DB_SRC_STORAGE_GB=100

# --- Engines and versions -----------------------------------------------------
#   *_SRC_VERSIONS  rows    - what the vendor apt repository serves for jammy
#   *_DST_VERSIONS  columns - managed engine versions
#
#   ⚠ SOURCE versions are NOT Docker Hub tags. The source image installs the
#     server from the vendor's apt repository, so only what that repository
#     offers on Ubuntu 22.04 can be built, and a version outside the list fails
#     during `docker build`:
#
#       mysql       8.0 · 8.4
#       mariadb     10.6 · 10.11 · 11.4 · 11.8
#       postgresql  13 · 14 · 15 · 16 · 17
#       mongodb     6.0 · 7.0 · 8.0
#
#   ⚠ TARGET versions are checked against the cb-tumblebug catalogue before
#     anything is created. cm-beetle does not error on a version it cannot offer:
#     selectEngineVersion attaches a warning and returns a DIFFERENT version with
#     a 200, so without that check an instance of the wrong version gets built.
#     To see what this region offers:
#         ./scripts/aws-db-versions.sh
#         ./scripts/aws-db-versions.sh --write     # write it into *_DST_VERSIONS
#
#   A prefix works (8.0 matches 8.0.36) - AWS and beetle both resolve it to a
#   current minor. Writing it in full is what makes a result reproducible.
#
#   ⚠ AWS MariaDB 11.8+ sets require_secure_transport=ON, and a logical database
#     cannot be created on such an instance from this stack. It is left in the
#     list on purpose: the column SKIPs with the reason printed, which is a result
#     worth having rather than something to hide.
#
#   ⚠ One target version = one RDS instance (5-30 min, billed while it exists).
AWS_ENGINES="mysql mariadb"
AWS_MYSQL_SRC_VERSIONS="8.0 8.4"
AWS_MYSQL_DST_VERSIONS="8.0 8.4"
AWS_MARIADB_SRC_VERSIONS="10.6 10.11 11.4 11.8"
AWS_MARIADB_DST_VERSIONS="10.6 11.8"


# ##############################################################################
# ###   N C P        Cloud DB: mysql
# ##############################################################################
#   NCP has no managed MariaDB at all, and its managed PostgreSQL and MongoDB
#   exist but cm-beetle cannot ask for them yet. So NCP_ENGINES is mysql.

# --- Region, zones, network ---------------------------------------------------
#   ⚠ The connection is ncp-<region> and beetle lowercases the whole string, so
#     the registered region id is what matters here, not its case.
NCP_REGION=KR
NCP_ZONE=KR-1
NCP_ZONE2=KR-2
NCP_VNET_CIDR=10.20.0.0/16
# NCP_SUBNET1_CIDR=
# NCP_SUBNET2_CIDR=

# --- The managed instance -----------------------------------------------------
#   NCP password rules, checked before anything is provisioned - NCP otherwise
#   reports the violation as a failed creation about 30 minutes later:
#     - 8 to 20 characters
#     - at least one letter, one digit and one special character
#     - allowed:   ~ ! @ # $ % ^ * ( ) - _ = [ ] { } ; : , . < > ?
#     - forbidden: ` & + \ " ' /  and whitespace
#     - example:   Cent1pede!2024
NCP_DB_PASSWORD=
NCP_DB_ADMIN_USERNAME=dbadmin
#   Carried into the create call, as on AWS. cm-beetle's recommendation lowers a
#   requested true to false here - "NCP Cloud DB does not provide external public
#   IP by default" - and the matrix puts it back, so the request says what this
#   file says.
#
#   ⚠ It does not produce a public domain on its own. That is still the console
#     step the run stops for; this only keeps the request honest.
NCP_DB_PUBLIC_ACCESS=true

#   Same reasoning as AWS_DB_BACKUP_RETENTION_DAYS above - keep it at 0 so binary
#   logging stays off and a stored function can be restored without SUPER.
NCP_DB_BACKUP_RETENTION_DAYS=0

NCP_DB_SRC_VCPU=2
NCP_DB_SRC_MEMORY_GB=4
NCP_DB_SRC_STORAGE_GB=100

# --- Engines and versions -----------------------------------------------------
#   Write NCP target versions in full (8.0.36, not 8.0). The catalogue lists full
#   strings; a prefix works, but leaves which minor you got up to the catalogue's
#   order rather than to you.
#       ./scripts/ncp-db-versions.sh
#
#   SOURCE versions follow the apt table in the AWS section above.
NCP_ENGINES="mysql"
NCP_MYSQL_SRC_VERSIONS="8.0 8.4"
NCP_MYSQL_DST_VERSIONS="8.0.36 8.4.8"

# --- NCP public domain (a console step) ---------------------------------------
#   Nothing to configure. After an instance is created the run stops and waits
#   for Enter, once per target version:
#
#     NCP console > Database > Cloud DB for <engine> > select the DB server
#       > DB Management > Public Domain Management > Request
#
#   It waits regardless of NO_PAUSE. Without a public domain, every cell in that
#   column would try the private domain and fail.


# ==============================================================================
# ===   R U N   C O N T R O L
# ==============================================================================

# ONLY_ENGINES - empty means all of <CSP>_ENGINES
ONLY_ENGINES=

# ONLY_CELLS - run selected cells only. "src:dst" or "engine:src:dst", space
#   separated.  e.g. ONLY_CELLS="8.0:8.4"   ONLY_CELLS="mariadb:10.6:10.11"
#   A column filtered out entirely creates no instance.
ONLY_CELLS=

#   1 stops the matrix at the first FAIL
STOP_ON_FAIL=0
#   1 keeps a failed cell's source container for debugging
KEEP_ON_FAIL=0
#   1 keeps the managed instances - THEY KEEP BILLING
KEEP_INSTANCE=0
#   1 keeps the vNet, security group and namespace for the next run
KEEP_NETWORK=0
#   1 reuses an instance of the same name that is already there
REUSE_INSTANCE=1

# RDBMS_TIMEOUT        - how long to wait for a managed instance, in seconds.
#                        NCP goes past 30 minutes often enough to matter.
# RDBMS_POLL_INTERVAL  - how often the async create request is polled.
# TARGET_REACH_TIMEOUT - TCP reachability of the target endpoint, in seconds.
RDBMS_TIMEOUT=2400
RDBMS_POLL_INTERVAL=15
TARGET_REACH_TIMEOUT=180

# DELETE_RETRIES / DELETE_RETRY_WAIT - a delete is retried this many times, this
#   many seconds apart. cb-tumblebug checks the CSP for 15s after a delete and,
#   if the resource is still there, returns a failure with its record intact
#   rather than stranding the resource. NCP needs the retries.
DELETE_RETRIES=3
DELETE_RETRY_WAIT=60

#   1 does not wait for a keypress between cells.
#   ⚠ The NCP public-domain wait ignores this.
NO_PAUSE=1
#   1 writes neither .log file. The result JSON is still written, so logs/ is
#   created either way.
NO_LOG=0

# cm-centipede UI — server-side endpoints.
# No NEXT_PUBLIC_ prefix: these never reach the browser bundle.

CENTIPEDE_ENDPOINT=http://localhost:8085
CENTIPEDE_API_USERNAME=ChangeMe
CENTIPEDE_API_PASSWORD=ChangeMe

# cm-honeybee takes no credentials — cm-centipede's own config has none for it.
HONEYBEE_ENDPOINT=http://localhost:8081

# cm-beetle is Basic Auth, like cm-centipede.
BEETLE_ENDPOINT=http://localhost:8056
BEETLE_API_USERNAME=ChangeMe
BEETLE_API_PASSWORD=ChangeMe
